{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtalex66.local/schemas/design-handoff.json",
  "title": "Commercial Design Handoff",
  "type": "object",
  "required": [
    "project_id",
    "version",
    "artifacts",
    "assets",
    "licenses",
    "approvals"
  ],
  "properties": {
    "project_id": {
      "type": "string"
    },
    "version": {
      "type": "string"
    },
    "design_system": {
      "type": "object",
      "properties": {
        "design_md": {
          "type": "string"
        },
        "dtcg_tokens": {
          "type": "string"
        },
        "component_manifest": {
          "type": "string"
        }
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "role",
          "format",
          "editable",
          "hash"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "format": {
            "type": "string"
          },
          "editable": {
            "type": "boolean"
          },
          "hash": {
            "type": "string"
          },
          "preview": {
            "type": "string"
          }
        }
      }
    },
    "assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "path",
          "source",
          "license"
        ],
        "properties": {
          "path": {
            "type": "string"
          },
          "source": {
            "type": "string"
          },
          "license": {
            "type": "string"
          },
          "modifications": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "c2pa_manifest": {
            "type": "string"
          }
        }
      }
    },
    "licenses": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "component",
          "spdx"
        ],
        "properties": {
          "component": {
            "type": "string"
          },
          "spdx": {
            "type": "string"
          },
          "notice": {
            "type": "string"
          }
        }
      }
    },
    "preflight_reports": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "approvals": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "role",
          "status"
        ],
        "properties": {
          "role": {
            "type": "string"
          },
          "status": {
            "enum": [
              "approved",
              "approved-with-notes",
              "rejected",
              "pending"
            ]
          },
          "note": {
            "type": "string"
          }
        }
      }
    },
    "known_limits": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": true
}
