{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-lab/benchmark-result/v1",
  "title": "WORK-LAB Benchmark Result",
  "type": "object",
  "required": ["benchmarkId", "evidenceLevel", "status", "scores"],
  "properties": {
    "benchmarkId": {"type": "string", "minLength": 1},
    "evidenceLevel": {"type": "string", "enum": ["E0", "E1", "E2", "E3", "E4", "E5"]},
    "status": {"type": "string", "enum": ["not-run", "isolated", "human-review", "accepted", "blocked"]},
    "scores": {"type": "object", "additionalProperties": {"type": "number"}},
    "humanCalibrationRequired": {"type": "boolean"}
  },
  "additionalProperties": false
}
