{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Typography System",
  "type": "object",
  "required": [
    "roles",
    "scale",
    "spacing",
    "language_support",
    "microtype",
    "failure_gates"
  ],
  "properties": {
    "roles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "purpose",
          "family_class",
          "weight",
          "size",
          "line_height"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "purpose": {
            "type": "string"
          },
          "family_class": {
            "type": "string"
          },
          "weight": {
            "type": "number"
          },
          "size": {
            "type": "string"
          },
          "line_height": {},
          "tracking": {
            "type": "string"
          }
        }
      }
    },
    "scale": {
      "type": "string"
    },
    "spacing": {
      "type": "object"
    },
    "language_support": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "microtype": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
