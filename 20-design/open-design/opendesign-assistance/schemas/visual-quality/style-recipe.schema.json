{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Style Recipe",
  "type": "object",
  "required": [
    "project_dna",
    "lineage_weights",
    "craft_directives",
    "originality_guard"
  ],
  "properties": {
    "project_dna": {
      "type": "object",
      "required": [
        "weight",
        "thesis"
      ],
      "properties": {
        "weight": {
          "type": "number",
          "minimum": 0.5,
          "maximum": 1
        },
        "thesis": {
          "type": "string"
        }
      }
    },
    "lineage_weights": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "weight"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.3
          }
        }
      }
    },
    "master_method_refs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "weight"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "weight": {
            "type": "number",
            "minimum": 0,
            "maximum": 0.2
          }
        }
      }
    },
    "craft_directives": {
      "type": "object",
      "properties": {
        "composition": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "typography": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "color": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "image": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "material_light": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "motion": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "originality_guard": {
      "type": "object",
      "required": [
        "forbidden_signature_elements",
        "name_free_generation_prompt"
      ],
      "properties": {
        "forbidden_signature_elements": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "name_free_generation_prompt": {
          "type": "string"
        }
      }
    }
  },
  "additionalProperties": false
}
