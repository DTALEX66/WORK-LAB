{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Master Research Evidence",
  "type": "object",
  "required": [
    "subject",
    "identity_status",
    "sources",
    "works_or_phases",
    "observations",
    "inferences",
    "forbidden_signature_elements"
  ],
  "properties": {
    "subject": {
      "type": "string"
    },
    "identity_status": {
      "enum": [
        "verified",
        "needs-verification",
        "ambiguous"
      ]
    },
    "sources": {
      "type": "array",
      "minItems": 2,
      "items": {
        "type": "object",
        "required": [
          "title",
          "source_type",
          "url",
          "rights_status"
        ],
        "properties": {
          "title": {
            "type": "string"
          },
          "source_type": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "rights_status": {
            "type": "string"
          },
          "primary_or_institutional": {
            "type": "boolean"
          }
        }
      }
    },
    "works_or_phases": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "object"
      }
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "transferable_methods": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "exceptions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "forbidden_signature_elements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "name_free_directives": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
