{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Material and Lighting Direction",
  "type": "object",
  "required": [
    "medium",
    "materials",
    "lighting",
    "camera_or_view",
    "realism_gates"
  ],
  "properties": {
    "medium": {
      "type": "string"
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "surface",
          "roughness_logic",
          "edge_logic"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "surface": {
            "type": "string"
          },
          "roughness_logic": {
            "type": "string"
          },
          "edge_logic": {
            "type": "string"
          }
        }
      }
    },
    "lighting": {
      "type": "object",
      "required": [
        "key",
        "fill",
        "contrast",
        "color_temperature_logic"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "camera_or_view": {
      "type": "object"
    },
    "realism_gates": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
