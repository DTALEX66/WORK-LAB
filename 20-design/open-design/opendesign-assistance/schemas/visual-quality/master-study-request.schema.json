{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Master Study Request",
  "type": "object",
  "required": [
    "subject",
    "project_context",
    "study_axes",
    "source_requirements"
  ],
  "properties": {
    "subject": {
      "type": "string"
    },
    "project_context": {
      "type": "string"
    },
    "study_axes": {
      "type": "array",
      "minItems": 3,
      "items": {
        "enum": [
          "concept",
          "composition",
          "typography",
          "color",
          "image",
          "material",
          "light",
          "motion",
          "production",
          "process",
          "cultural-context",
          "commercial-system"
        ]
      }
    },
    "source_requirements": {
      "type": "object",
      "required": [
        "minimum_sources",
        "primary_or_archive_required"
      ],
      "properties": {
        "minimum_sources": {
          "type": "integer",
          "minimum": 2
        },
        "primary_or_archive_required": {
          "type": "boolean"
        }
      }
    },
    "output_mode": {
      "enum": [
        "analysis-only",
        "method-card",
        "style-recipe-input"
      ]
    }
  },
  "additionalProperties": false
}
