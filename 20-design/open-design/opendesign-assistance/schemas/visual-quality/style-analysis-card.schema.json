{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Style Analysis Card",
  "type": "object",
  "required": [
    "id",
    "title",
    "core_problem",
    "decision_logic",
    "craft_grammar",
    "failure_modes",
    "final_prompt_policy"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "analysis_status": {
      "type": "string"
    },
    "analysis_group": {
      "type": "string"
    },
    "core_problem": {
      "type": "string"
    },
    "decision_logic": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "design_feel_vector": {
      "type": "object"
    },
    "craft_grammar": {
      "type": "object"
    },
    "commercial_applications": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "quality_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "failure_modes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "pairing_rule": {
      "type": "string"
    },
    "counterweight_rule": {
      "type": "string"
    },
    "research_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_requirement": {
      "type": "object"
    },
    "influence_cap": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.35
    },
    "final_prompt_policy": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
