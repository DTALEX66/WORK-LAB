{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Style Lineage",
  "type": "object",
  "required": [
    "id",
    "title",
    "core_thesis",
    "grammar",
    "anti_cliches"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "core_thesis": {
      "type": "string"
    },
    "grammar": {
      "type": "object",
      "required": [
        "composition",
        "typography",
        "color",
        "material_image"
      ],
      "additionalProperties": {
        "type": "string"
      }
    },
    "transfer_rule": {
      "type": "string"
    },
    "anti_cliches": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "influence_cap": {
      "type": "number",
      "minimum": 0,
      "maximum": 0.35
    }
  },
  "additionalProperties": false
}
