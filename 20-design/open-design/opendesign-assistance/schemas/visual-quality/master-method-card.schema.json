{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "master-method-card.schema.json",
  "title": "Master Method Card",
  "type": "object",
  "required": [
    "id",
    "name",
    "thesis",
    "transferable_methods",
    "shallow_mimicry_risks"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "lineages": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "thesis": {
      "type": "string"
    },
    "transferable_methods": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    },
    "quality_signals": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "shallow_mimicry_risks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "generation_translation": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "observation"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "observation": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "card_status": {
      "type": "string"
    },
    "evidence_status": {
      "type": "string"
    },
    "research_dimensions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "commercial_translation_questions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_evidence": {
      "type": "object"
    }
  },
  "additionalProperties": false
}
