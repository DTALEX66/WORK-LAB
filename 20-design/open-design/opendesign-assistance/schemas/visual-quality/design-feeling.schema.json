{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Design Feeling Target",
  "type": "object",
  "required": [
    "targets",
    "evidence_map",
    "conflicts"
  ],
  "properties": {
    "targets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "axis",
          "target",
          "tolerance"
        ],
        "properties": {
          "axis": {
            "type": "string"
          },
          "target": {
            "type": "number",
            "minimum": -1,
            "maximum": 1
          },
          "tolerance": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    },
    "evidence_map": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "conflicts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "thumbnail_read": {
      "type": "string"
    },
    "normal_read": {
      "type": "string"
    },
    "detail_read": {
      "type": "string"
    }
  },
  "additionalProperties": false
}
