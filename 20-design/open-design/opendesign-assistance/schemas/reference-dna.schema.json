{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtalex66.local/schemas/reference-dna.json",
  "title": "Reference Design DNA",
  "type": "object",
  "required": [
    "source",
    "ownership",
    "macrostructure",
    "visual_language",
    "transfer_rules"
  ],
  "properties": {
    "source": {
      "type": "string"
    },
    "ownership": {
      "enum": [
        "owned",
        "authorized",
        "public-reference",
        "unknown"
      ]
    },
    "capture_method": {
      "enum": [
        "screenshot",
        "url",
        "file",
        "manual-notes"
      ]
    },
    "macrostructure": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "visual_language": {
      "type": "object",
      "properties": {
        "composition": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "type_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "color_roles": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shape_language": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "imagery": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "motion": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "distinctive_elements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "transfer_rules": {
      "type": "object",
      "required": [
        "may_transfer",
        "must_not_copy"
      ],
      "properties": {
        "may_transfer": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "must_not_copy": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim": {
            "type": "string"
          },
          "location": {
            "type": "string"
          },
          "confidence": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        }
      }
    }
  },
  "additionalProperties": true
}
