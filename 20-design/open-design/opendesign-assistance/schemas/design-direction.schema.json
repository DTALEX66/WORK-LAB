{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtalex66.local/schemas/design-direction.json",
  "title": "Design Direction",
  "type": "object",
  "required": [
    "id",
    "thesis",
    "system",
    "applications",
    "risks"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "name": {
      "type": "string"
    },
    "thesis": {
      "type": "string"
    },
    "strategy_link": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "system": {
      "type": "object",
      "required": [
        "composition",
        "typography",
        "color",
        "imagery",
        "materials"
      ],
      "properties": {
        "composition": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "typography": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "color": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "imagery": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "materials": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "motion": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "shape_language": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "applications": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "artifact",
          "rule"
        ],
        "properties": {
          "artifact": {
            "type": "string"
          },
          "rule": {
            "type": "string"
          }
        }
      }
    },
    "differentiation": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "risks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "risk",
          "mitigation"
        ],
        "properties": {
          "risk": {
            "type": "string"
          },
          "mitigation": {
            "type": "string"
          }
        }
      }
    }
  },
  "additionalProperties": true
}
