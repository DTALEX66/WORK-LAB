{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtalex66.local/schemas/case-record.json",
  "title": "Design Benchmark Case",
  "type": "object",
  "required": [
    "id",
    "discipline",
    "brief",
    "expected",
    "evaluation"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "discipline": {
      "type": "string"
    },
    "brief": {
      "type": "string"
    },
    "inputs": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "expected": {
      "type": "object",
      "properties": {
        "artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "hard_constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "properties": {
        "rubric": {
          "type": "string"
        },
        "baseline_required": {
          "type": "boolean"
        },
        "human_review_required": {
          "type": "boolean"
        }
      }
    },
    "license": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
