{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtalex66.local/schemas/preflight.json",
  "title": "Commercial Production Preflight",
  "type": "object",
  "required": [
    "profile",
    "artifact",
    "checks",
    "result"
  ],
  "properties": {
    "profile": {
      "enum": [
        "digital-ui",
        "print-commercial",
        "spatial-exhibition",
        "packaging",
        "3d-asset",
        "motion",
        "presentation",
        "editorial"
      ]
    },
    "artifact": {
      "type": "string"
    },
    "checks": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "severity",
          "result",
          "evidence"
        ],
        "properties": {
          "id": {
            "type": "string"
          },
          "severity": {
            "enum": [
              "blocker",
              "high",
              "medium",
              "low",
              "info"
            ]
          },
          "result": {
            "enum": [
              "pass",
              "fail",
              "warning",
              "not-applicable"
            ]
          },
          "evidence": {},
          "remediation": {
            "type": "string"
          }
        }
      }
    },
    "result": {
      "enum": [
        "pass",
        "conditional-pass",
        "fail"
      ]
    },
    "operator": {
      "type": "string"
    },
    "timestamp": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
