{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "style-lineage-mapper",
  "title": "Style Lineage Mapper",
  "version": "0.2.1",
  "publishedAt": "2026-08-04T00:00:00Z",
  "description": "Map a brief and references to historical, regional and medium-specific design lineages.",
  "author": {
    "name": "DTALEX66 OPEN-DESIGN-Assistance"
  },
  "license": "MIT",
  "tags": [
    "atom",
    "visual-quality",
    "art-direction"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "atom",
    "taskKind": "new-generation",
    "mode": "atom",
    "useCase": {
      "query": {
        "en": "Map a brief and references to historical, regional and medium-specific design lineages.",
        "zh-CN": "Map a brief and references to historical, regional and medium-specific design lineages."
      }
    },
    "inputs": [
      {
        "name": "brief",
        "type": "text",
        "required": true
      },
      {
        "name": "references",
        "type": "file",
        "required": false
      }
    ],
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ]
  }
}
