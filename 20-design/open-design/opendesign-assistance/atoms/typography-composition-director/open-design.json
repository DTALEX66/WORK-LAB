{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "typography-composition-director",
  "title": "Typography & Composition Director",
  "version": "0.2.1",
  "publishedAt": "2026-08-04T00:00:00Z",
  "description": "Resolve hierarchy, grid, rhythm, negative space, CJK/Latin typography and optical alignment.",
  "author": {
    "name": "DTALEX66 OPEN-DESIGN-Assistance"
  },
  "license": "MIT",
  "tags": [
    "atom",
    "visual-quality",
    "art-direction"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "atom",
    "taskKind": "new-generation",
    "mode": "atom",
    "useCase": {
      "query": {
        "en": "Resolve hierarchy, grid, rhythm, negative space, CJK/Latin typography and optical alignment.",
        "zh-CN": "Resolve hierarchy, grid, rhythm, negative space, CJK/Latin typography and optical alignment."
      }
    },
    "inputs": [
      {
        "name": "artifact",
        "type": "file",
        "required": true
      },
      {
        "name": "language",
        "type": "string",
        "required": false
      },
      {
        "name": "format",
        "type": "string",
        "required": false
      }
    ],
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ]
  }
}
