{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "style-vector-builder",
  "title": "Style Vector Builder",
  "version": "0.2.1",
  "description": "Translate lineage analysis into a project-specific design-feeling and craft vector.",
  "author": {
    "name": "DTALEX66 OPEN-DESIGN-Assistance"
  },
  "license": "MIT",
  "tags": [
    "atom",
    "visual-quality"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "atom",
    "mode": "atom",
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ]
    },
    "inputs": [
      {
        "name": "brief",
        "type": "text",
        "required": true
      },
      {
        "name": "lineage_cards",
        "type": "file",
        "required": true
      }
    ],
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ]
  }
}
