{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-lab/minigame-design-brief/v1",
  "title": "MINIGAME Design Brief",
  "type": "object",
  "required": ["briefId", "screenGoal", "visualState", "viewport", "evidenceLevel"],
  "properties": {
    "briefId": {"type": "string", "minLength": 1},
    "screenGoal": {"type": "string", "minLength": 1},
    "visualState": {"type": "string", "enum": ["normal", "anomaly", "danger", "debrief"]},
    "viewport": {"type": "string", "minLength": 1},
    "evidenceLevel": {"type": "string", "enum": ["E0", "E1", "E2", "E3", "E4", "E5"]},
    "touchHotspots": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
