{
  "schema_version": "workflow/domain-pack/v1",
  "pack_id": "minigame-design",
  "version": "0.1.0",
  "display_name": "MINIGAME Design Domain Pack",
  "description": "Open Design patterns for mobile game HUD, CCTV-led anomaly interfaces, interaction states, and implementation handoff. It excludes product platform, advertising, release, revenue, and player-operations capabilities.",
  "capabilities": [
    "mobile-hud-layout",
    "cctv-primary-visual",
    "industrial-console-material",
    "safe-area-and-touch-hotspots",
    "normal-anomaly-danger-states",
    "low-text-density",
    "responsive-runtime-fixture",
    "visual-and-interaction-qa",
    "implementation-handoff"
  ],
  "entrypoints": {
    "human": ["小游戏 UI", "游戏 HUD", "CCTV 监控界面", "异常电梯视觉"],
    "machine": ["minigame-design", "minigame-ui-director"]
  },
  "evidence_policy": {
    "minimum_level": "E2",
    "required_artifacts": ["brief", "profile", "visual-qa-report", "handoff", "runtime-smoke"]
  },
  "safety": {
    "approval_required": true,
    "forbidden_paths": ["E:/", "**/.env", "**/credentials.json", "**/auth.json"],
    "redaction_required": true
  },
  "excluded_capabilities": [
    "advertising",
    "product-analytics",
    "revenue",
    "platform-release",
    "player-operations",
    "multi-game-catalog"
  ]
}
