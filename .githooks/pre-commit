#!/usr/bin/env bash
# pre-commit hook — keep .project/governance/generated/CURRENT_STATE.{json,md} in step with the commit.
#
# 背景: 手动重生成 CURRENT_STATE 是哈希噪音的来源（每次改 tracked 文件都要跑），所以放在提交时自动做。
#
# 2026-10-10 修复（ERR-261）: 这个 hook 曾经长期静默空转，两个原因叠在一起——
#   1) 它调用裸 `python`。这台机器上 PATH 里没有 python（项目解释器是
#      `.project-local/toolchains/wl-py311/Scripts/python.exe`，与 CI 一致），于是
#      `if python … >/dev/null 2>&1` 为假，什么都不做；
#   2) 即使跑成，它 `git add` 的是收敛前布局的 `00-governance/generated/CURRENT_STATE.*`，
#      真实产物在 `.project/governance/generated/`，所以生成的字节从不进入提交。
# 两者都带 `exit 0`，所以本地门一直绿，而 CI 的 `--check-current` 在 47d13507 上读到
# recorded=3992b069931e / recomputed=55f3237b0127。现在：解释器按声明的顺序解析，路径改成真实
# 产物，任何一步失败都让提交失败并说明原因——把“投影过期”静默发布出去正是这个 hook 存在的理由的反面。
#
# 启用: git config core.hooksPath .githooks
# 跳过: git commit --no-verify（不推荐，需显式理由）

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0

# 空提交/无 staged 改动则跳过
git diff --cached --quiet 2>/dev/null && exit 0

PROJECTION_JSON=".project/governance/generated/CURRENT_STATE.json"
PROJECTION_MD=".project/governance/generated/CURRENT_STATE.md"
GENERATOR="$ROOT/scripts/ci/generate_current_state.py"

# 收集 staged 的 tracked 改动（排除投影自身，避免循环）
CHANGED="$(git diff --cached --name-only 2>/dev/null | grep -vE "^\.project/governance/generated/CURRENT_STATE\.(json|md)$" | grep -vE '^\.hermes/')"

if [ -z "$CHANGED" ]; then
  exit 0
fi

PY=""
for candidate in "$ROOT/.project-local/toolchains/wl-py311/Scripts/python.exe" \
                 "$ROOT/.project-local/toolchains/wl-py311/bin/python" \
                 python python3; do
  if command -v "$candidate" >/dev/null 2>&1 || [ -x "$candidate" ]; then
    PY="$candidate"
    break
  fi
done
if [ -z "$PY" ]; then
  echo "PRE_COMMIT_FAIL no python interpreter: expected the declared project toolchain" >&2
  echo "  (.project-local/toolchains/wl-py311/Scripts/python.exe) or python/python3 on PATH." >&2
  echo "  Refusing to commit a tree whose CURRENT_STATE projection would go stale." >&2
  exit 1
fi

if ! "$PY" "$GENERATOR" --root "$ROOT"; then
  echo "PRE_COMMIT_FAIL $PY $GENERATOR --root $ROOT exited non-zero;" >&2
  echo "  the projection was NOT regenerated — fix the generator, do not commit past it." >&2
  exit 1
fi

if ! git add -- "$PROJECTION_JSON" "$PROJECTION_MD"; then
  echo "PRE_COMMIT_FAIL git add -- $PROJECTION_JSON $PROJECTION_MD failed;" >&2
  echo "  regenerated bytes would not reach the commit." >&2
  exit 1
fi
exit 0
