{
  "schemaVersion": "work-lab/provider-registry/v1",
  "title": "WORK-LAB logical model provider registry — the only model identifiers projects may reference",
  "purpose": "Projects (ArcheAxis-Knowledge-OS, WORK-LAB, DESIGN-LAB) call these logical provider ids. A provider id hides the runtime, the file name, the quantization and every absolute path. Physical binding lives in model-registry.json + runtime-registry.json.",
  "precedence": "WORK-LAB-AUTHORITY.md > .project/governance/project-authority-index.json > this file.",
  "banned_in_client_code": [
    "GGUF file names",
    "quantization names",
    "Windows absolute paths",
    "runtime executable paths",
    "raw model root paths"
  ],
  "providers": [
    {
      "id": "local.fast.default",
      "display_name": "Local FAST (quick classification / extraction / rewrite / routing)",
      "binds_to_model": "qwen3.5-4b",
      "binds_to_runtime": "llamacpp",
      "endpoint": "http://127.0.0.1:8081/v1",
      "api_shape": "openai-compatible",
      "model_name_on_wire": "qwen3.5-4b-q4_K_M (llama-server serves the GGUF directly; the wire id is the file path, callers must use this provider id instead)",
      "capabilities": ["text.fast", "classify", "extract", "rewrite", "route", "summarize.short"],
      "context_window": 8192,
      "required_request_options": {"chat_template_kwargs": {"enable_thinking": false},
                                   "why": "Qwen3.5 is a reasoning model; without this the visible content is empty and the token budget is consumed by reasoning"},
      "measured": {"gen_tok_per_s_warm": 8.04, "prompt_tokens_probe": 312},
      "allowed_projects": ["ArcheAxis-Knowledge-OS", "WORK-LAB", "DESIGN-LAB"],
      "access_tier": "shared-common",
      "expected_latency_class": "interactive (<5s first answer at 8k context)",
      "fallback": ["local.fast.legacy"],
      "owner": "WORK-LAB",
      "binding_note": "Served by llama.cpp straight from the shared-library GGUF so the weight exists exactly once. An Ollama-route binding was attempted first and abandoned: the Ollama CDN measured 136 KB/s here and the pull never completed, so no Ollama copy of this model exists."
    },
