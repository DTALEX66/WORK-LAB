  "accessTiers": {
    "shared-common": "All three projects may call it when a real task needs it.",
    "archeaxis-first": "Authorized to ArcheAxis by default; other projects only on a real, declared need.",
    "worklab-only": "Used by WORK-LAB itself.",
    "standby": "Present, not the default, not deleted."
  },
  "defaultExposure": {
    "note": "brief section 10: do NOT expose the whole ArcheAxis ingestion pipeline to every project by default.",
    "shared-common": ["local.fast.default", "local.deep.default"],
    "archeaxisOnly": ["local.embedding.default", "local.reranker.default", "local.ocr.default", "local.asr.default", "local.asr.cpu.sensevoice"]
  },
  "lastVerified": "2026-09-28"
