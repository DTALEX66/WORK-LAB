{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-lab/capability-conformance/v1",
  "title": "WORK-LAB Capability Conformance Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "scope", "acp", "skills", "mcp"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": "work-lab/capability-conformance/v1"},
    "scope": {"const": ["workflow-assistance", "work-lab-observer"]},
    "acp": {"$ref": "#/$defs/protocol"},
    "skills": {"$ref": "#/$defs/protocol"},
    "mcp": {"$ref": "#/$defs/protocol"}
  },
  "$defs": {
    "protocol": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "entries"],
      "properties": {
        "status": {"enum": ["STATIC_UNVERIFIED", "STATIC_PASS", "BLOCKED"]},
        "entries": {"type": "array", "items": {"$ref": "#/$defs/entry"}}
      }
    },
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "capabilities", "transport", "permissions", "source"],
      "properties": {
        "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
        "capabilities": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "transport": {"enum": ["manifest-only", "stdio", "sse", "external"]},
        "permissions": {"type": "array", "items": {"enum": ["read-only", "write", "execute", "network"]}, "uniqueItems": true},
        "source": {"type": "string", "minLength": 1}
      }
    }
  }
}
