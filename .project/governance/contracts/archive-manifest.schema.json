{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-lab/archive-manifest/v1",
  "title": "WORK-LAB Archive Manifest",
  "type": "object",
  "required": ["archiveId", "source", "classification", "recovery", "status"],
  "properties": {
    "archiveId": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "classification": {"type": "string", "enum": ["product-history", "fixture-source", "reference-only", "regenerate-or-exclude"]},
    "recovery": {"type": "object", "required": ["repository", "refs", "verification"], "properties": {"repository": {"type": "string"}, "refs": {"type": "array", "items": {"type": "string"}}, "verification": {"type": "string"}}, "additionalProperties": false},
    "status": {"type": "string", "enum": ["planned", "recorded", "verified", "blocked"]}
  },
  "additionalProperties": false
}
