{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-lab/module-profile/v1",
  "title": "WORK-LAB Module Profile",
  "type": "object",
  "required": ["schemaVersion", "id", "path", "owner", "role", "releasePrefix", "dependsOn"],
  "properties": {
    "schemaVersion": {"const": "work-lab/module-profile/v1"},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
    "path": {"type": "string", "minLength": 1},
    "owner": {"type": "string", "minLength": 1},
    "role": {"type": "string", "minLength": 1},
    "releasePrefix": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"},
    "dependsOn": {"type": "array", "items": {"type": "string", "pattern": "^[a-z][a-z0-9-]+$"}},
    "evidencePath": {"type": "string", "minLength": 1},
    "externalMutationDefault": {"const": false}
  },
  "additionalProperties": false
}
