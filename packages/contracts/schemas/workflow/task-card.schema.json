{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-lab/task-card/v1",
  "title": "WORK-LAB Task Card",
  "type": "object",
  "required": ["schema_version", "id", "title", "scope", "action", "acceptance"],
  "properties": {
    "schema_version": {"const": "work-lab/task-card/v1"},
    "id": {"type": "string", "pattern": "^(BASE|ROOT|MIG|WA|CONT|OBS|OD|MG|INT)-[0-9]{3}$"},
    "title": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "minLength": 1},
    "action": {"type": "string", "minLength": 1},
    "acceptance": {"type": "string", "minLength": 1},
    "phase": {"type": "string", "minLength": 1},
    "priority": {"enum": ["P0", "P1", "P2", "P3"]},
    "constraints": {"type": "array", "items": {"type": "string"}}
  },
  "additionalProperties": false
}
