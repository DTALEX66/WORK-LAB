{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-assistance.invalid/schemas/observer-event.schema.json",
  "title": "Workflow Observer Event",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "sequence", "event_id", "run_id", "task_id", "event_type", "occurred_at", "source", "payload"],
  "properties": {
    "schema_version": {"const": "workflow/observer-event/v1"},
    "sequence": {"type": "integer", "minimum": 1},
    "event_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "task_id": {"type": "string", "minLength": 1},
    "event_type": {"type": "string", "minLength": 1},
    "occurred_at": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "projection_key": {"type": "string", "minLength": 1},
    "payload": {"type": "object", "additionalProperties": true}
  }
}
