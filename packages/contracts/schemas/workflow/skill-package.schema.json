{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-lab/skill-package/v1",
  "title": "WORK-LAB Skill Package",
  "type": "object",
  "required": ["schema_version", "id", "version", "source", "packageDigest", "status"],
  "properties": {
    "schema_version": {"const": "workflow/skill-package/v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "source": {"type": "string", "minLength": 1},
    "packageDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "status": {"type": "string", "enum": ["candidate", "isolated", "approved", "deployed", "blocked", "retired"]},
    "risk": {"type": "string", "enum": ["low", "medium", "high", "critical"]}
  },
  "additionalProperties": false
}
