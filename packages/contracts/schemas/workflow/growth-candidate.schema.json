{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-lab/growth-candidate/v1",
  "title": "WORK-LAB Growth Candidate",
  "type": "object",
  "required": ["schema_version", "candidateId", "origin", "classification", "status", "risk"],
  "properties": {
    "schema_version": {"const": "workflow/growth-candidate/v1"},
    "candidateId": {"type": "string", "minLength": 1},
    "origin": {"type": "string", "minLength": 1},
    "classification": {"type": "string", "enum": ["curator", "learn", "manual", "hub", "upstream", "deployment"]},
    "status": {"type": "string", "enum": ["discovered", "isolated", "scanned", "evaluated", "candidate", "approved", "blocked", "retired"]},
    "risk": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "sourceDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
