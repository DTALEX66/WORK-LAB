{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-assistance.invalid/schemas/task-ledger.schema.json",
  "title": "Workflow Task Ledger Contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "tasks"],
  "properties": {
    "schema_version": {"const": "workflow/task-ledger/v1"},
    "tasks": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/task"
      }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "additionalProperties": false,
      "required": ["task_id", "run_id", "idempotency_key", "status", "checkpoint", "cursor_version", "waitpoint", "retry_count", "budget", "usage", "lease", "evidence", "parent_task_id", "dependencies", "children", "external_effects", "reconciliation", "created_at", "updated_at", "errors"],
      "properties": {
        "task_id": {"type": "string", "minLength": 1},
        "run_id": {"type": "string", "minLength": 1},
        "idempotency_key": {"type": "string", "minLength": 1},
        "status": {"enum": ["QUEUED", "PLANNING", "WAITING_APPROVAL", "RUNNING", "RETRYING", "PAUSED", "BLOCKED", "REVIEWING", "COMPLETED", "FAILED", "CANCELLED"]},
        "checkpoint": {"type": ["object", "null"]},
        "cursor_version": {"type": "integer", "minimum": 0},
        "waitpoint": {
          "type": ["object", "null"],
          "properties": {
            "kind": {"type": "string", "minLength": 1},
            "cursor": {"type": "object"},
            "holder": {"type": "string", "minLength": 1},
            "fence": {"type": "integer", "minimum": 1},
            "created_at": {"type": "string", "minLength": 1}
          },
          "required": ["kind", "cursor", "holder", "fence", "created_at"],
          "additionalProperties": false
        },
        "retry_count": {"type": "integer", "minimum": 0},
        "budget": {
          "type": "object",
          "required": ["tokens", "time_seconds", "tools", "max_retries"],
          "properties": {
            "tokens": {"type": ["integer", "null"], "minimum": 0},
            "time_seconds": {"type": ["integer", "null"], "minimum": 0},
            "tools": {"type": ["integer", "null"], "minimum": 0},
            "max_retries": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "usage": {
          "type": "object",
          "required": ["tokens", "time_seconds", "tools"],
          "properties": {
            "tokens": {"type": "integer", "minimum": 0},
            "time_seconds": {"type": "integer", "minimum": 0},
            "tools": {"type": "integer", "minimum": 0}
          },
          "additionalProperties": false
        },
        "lease": {
          "type": ["object", "null"],
          "properties": {
            "holder": {"type": "string", "minLength": 1},
            "fence": {"type": "integer", "minimum": 1},
            "acquired_at": {"type": "string", "minLength": 1},
            "heartbeat_at": {"type": "string", "minLength": 1},
            "expires_at": {"type": "string", "minLength": 1}
          },
          "required": ["holder", "fence", "acquired_at", "heartbeat_at", "expires_at"],
          "additionalProperties": false
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["evidence_id", "state", "source", "sha256"],
            "properties": {
              "evidence_id": {"type": "string", "minLength": 1},
              "state": {"enum": ["PASS", "FAIL", "BLOCKED", "UNVERIFIED"]},
              "source": {"type": "string", "minLength": 1},
              "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
            },
            "additionalProperties": false
          }
        },
        "parent_task_id": {"type": ["string", "null"]},
        "dependencies": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "children": {
          "type": "array",
          "maxItems": 8,
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        },
        "external_effects": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["effect_id", "action", "intent_digest", "status", "observed_digest", "created_at", "updated_at"],
            "properties": {
              "effect_id": {"type": "string", "minLength": 1},
              "action": {"type": "string", "minLength": 1},
              "intent_digest": {"type": "string", "minLength": 1},
              "status": {"enum": ["PENDING", "CONFIRMED", "ABSENT", "CONFLICT"]},
              "observed_digest": {"type": ["string", "null"]},
              "created_at": {"type": "string", "minLength": 1},
              "updated_at": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "reconciliation": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["effect_id", "status", "observed_digest", "at"],
            "properties": {
              "effect_id": {"type": "string", "minLength": 1},
              "status": {"enum": ["CONFIRMED", "ABSENT", "CONFLICT"]},
              "observed_digest": {"type": ["string", "null"]},
              "at": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          }
        },
        "created_at": {"type": "string", "minLength": 1},
        "updated_at": {"type": "string", "minLength": 1},
        "errors": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["code", "fingerprint", "retryable", "external_write", "at"],
            "properties": {
              "code": {"type": "string", "minLength": 1},
              "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{16}$"},
              "retryable": {"type": "boolean"},
              "external_write": {"type": "boolean"},
              "at": {"type": "string", "minLength": 1},
              "usage": {"type": "object"}
            },
            "additionalProperties": false
          }
        }
      }
    }
  }
}
