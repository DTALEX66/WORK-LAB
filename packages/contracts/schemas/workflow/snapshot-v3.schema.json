    },
    "taskRecords": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "taskId",
          "projectId",
          "status",
          "checkpointPresent",
          "checkpointKeys"
        ],
        "properties": {
          "taskId": {
            "type": "string",
            "minLength": 1
          },
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "minLength": 1
          },
          "fencingToken": {
            "type": [
              "integer",
              "null"
            ]
          },
          "checkpointPresent": {
            "type": "boolean"
          },
          "checkpointKeys": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "checkpointDigest": {
            "type": [
              "string",
              "null"
            ]
          },
          "createdAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "Added 2026-10-27. `snapshot_api.project_task_record` has always emitted these four store fields; the item simply never named them, so a projected fact had no authority (the same hole ERR-225 closed at the top level and the projects row closed in 2026-10-10). Null means the source states no time — a register row's `createdAt` is null because OPEN-TASK-REGISTER.md has no timestamp column, not because the row is new."
          },
          "updatedAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "leaseHolder": {
            "type": [
              "string",
              "null"
            ]
          },
          "leaseExpiresAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "register": {
            "type": [
              "object",
              "null"
            ],
            "required": [
              "source",
              "state",
              "priority",
              "work",
              "workChars",
              "workTruncated",
              "cellsRealigned",
              "evidenceRef",
              "reason"
            ],
            "additionalProperties": false,
            "properties": {
              "source": {
                "const": "OPEN_TASK_REGISTER"
              },
              "state": {
                "enum": [
                  "READ",
                  "UNREADABLE",
                  "ID_CONFLICT"
                ],
                "description": "READ = this record is one parsed table row. UNREADABLE = the register could not be read or judged (missing file, no pipe table, header that is not ID|Priority|Status|Work, zero data rows, or a row count that disagrees with scripts/ci/verify_register_table_shape.py) and this record is the single marker saying so — never an empty list, which would claim 'queried, nothing registered'. ID_CONFLICT = a register row whose taskId already belongs to a canonical `tasks` row; the register row was not projected and this marker names it."
              },
              "priority": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "The Priority cell exactly as written (P0/P1/...). Null when the cell is blank."
              },
              "work": {
                "type": "string",
                "maxLength": 600,
                "description": "A verbatim PREFIX of the Work cell — prose the owner wrote, escaped pipes restored. Capped because the cell is measured up to 18,447 characters (121,257 across the 42 live rows) and this list is re-sent on every snapshot; `open_task_register_projection.WORK_EXCERPT_CHARS` and this maxLength are the same number and a test pins them together. The cap is disclosed by workChars/workTruncated, never applied in silence."
              },
              "workChars": {
                "type": "integer",
                "minimum": 0,
                "description": "The Work cell's true character count before the cap, so a reader knows how much they are not seeing."
              },
              "workTruncated": {
                "type": "boolean"
              },
              "cellsRealigned": {
                "type": "boolean",
                "description": "True when the row declared more (or fewer) cells than its own header — the historical defect where an unescaped pipe inside backticked shell text split one sentence into extra columns. The surplus was rejoined into Work instead of dropped, and this flag says the row was reshaped."
              },
              "evidenceRef": {
                "type": "string",
                "minLength": 1,
                "description": "Where to re-read this row: `<register path>#L<line>`."
              },
              "reason": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "Why the row is a marker, or what was irregular about it (blank ID, blank Status, realigned cells). Null on an ordinary row."
              }
            }
          }
        },
        "additionalProperties": false
      },
      "description": "Deep-link targets. ABSENT means the producer did not query the task table, which is a different statement from an empty list (queried, nothing there); the checkpoint VALUES never enter a read-only projection, only their key names and a digest. Two sources feed this list and a row says which one it is: the canonical `tasks` table (no `register` key — measured 0 rows on this machine, 2026-10-27) and the live open-task register `taskpacks/current/OPEN-TASK-REGISTER.md`, projected by `open_task_register_projection` with `register.source = OPEN_TASK_REGISTER`. The register carries no project column, so its rows are attributed to the repository that owns the register (`work-lab`) rather than to a guessed per-row project."
    },
    "adapterCapabilities": {
      "type": "array",
      "items": {
