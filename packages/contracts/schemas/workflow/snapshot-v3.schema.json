          "git",
          "token",
          "ci",
          "executionIds",
          "sourceRefs"
        ],
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "agentPlatform": {
            "type": [
              "string",
              "null"
            ]
          },
