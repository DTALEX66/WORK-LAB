          "separated_results": {
            "type": "object",
            "description": "Three named stages, NOT an array and not one aggregate verdict: write / native_readback / target_behaviour. Each carries its own status AND basis, so a stage with basis NO_PRODUCER can never be summarised as PASSED.",
            "required": [
              "write",
              "native_readback",
              "target_behaviour"
            ],
            "properties": {
              "write": {
                "type": "object",
                "required": [
                  "status",
                  "basis",
                  "note"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "description": "Never null: an unanswered stage reads UNKNOWN, so 'not observed' cannot be mistaken for 'observed and fine'."
                  },
                  "basis": {
                    "type": "string",
                    "description": "LEDGER_STATE / EXTERNAL_EFFECT_RECONCILED / WORKTREE_ID / SESSION_ID / NONE / NO_PRODUCER. The basis, not the status, is the evidence."
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "native_readback": {
                "type": "object",
                "required": [
                  "status",
                  "basis",
                  "note"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "description": "Never null: an unanswered stage reads UNKNOWN, so 'not observed' cannot be mistaken for 'observed and fine'."
                  },
                  "basis": {
                    "type": "string",
                    "description": "LEDGER_STATE / EXTERNAL_EFFECT_RECONCILED / WORKTREE_ID / SESSION_ID / NONE / NO_PRODUCER. The basis, not the status, is the evidence."
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              },
              "target_behaviour": {
                "type": "object",
                "required": [
                  "status",
                  "basis",
                  "note"
                ],
                "properties": {
                  "status": {
                    "type": "string",
                    "description": "Never null: an unanswered stage reads UNKNOWN, so 'not observed' cannot be mistaken for 'observed and fine'."
                  },
                  "basis": {
                    "type": "string",
                    "description": "LEDGER_STATE / EXTERNAL_EFFECT_RECONCILED / WORKTREE_ID / SESSION_ID / NONE / NO_PRODUCER. The basis, not the status, is the evidence."
                  },
                  "note": {
                    "type": "string"
                  }
                },
                "additionalProperties": false
              }
            },
            "additionalProperties": false
          },
          "producer_gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "description": "WUI-21: one `worklab/isolated-trial/v1` document per trial, embedded verbatim. There is no aggregate success field on purpose — each separated result carries its own status AND basis, so a trial cannot be summarised into one verdict it never earned."
      }
