{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-lab/workflow-snapshot/v3",
  "title": "WORK-LAB read-only Observer snapshot (workflow/snapshot/v3)",
  "description": "The cross-language shape of the projection the sidecar answers at GET /api/v1/snapshot and pushes over /api/v1/events. Registered in the contract catalog because WUI-15's acceptance says the JSON Schema set is the single source of truth, and until now this payload was outside it: the shape lived in packages/client-neutral-core/scripts/snapshot_validator.py (Python) and apps/observer/frontend/src/types.ts (TypeScript) with nothing proving the two agreed, which is how ERR-225 happened — the producer emitted entryProbe/versionDrift that the front model never declared, so the facts could not be rendered and every gate stayed green. Division of labour, deliberately not a duplication: THIS schema owns the key set, the optionality of each key and the primitive types; snapshot_validator.py keeps the semantic invariants JSON Schema cannot state (capability-ladder monotonicity, checkpoint digest shape, duplicate handles, truncation without an ordering key). Top level is additionalProperties:false on purpose — a new producer key must arrive here as a decision, because an undeclared key is precisely the drift direction that is invisible from the reading side. Key set and optionality measured 2026-10-09 from the live sidecar readbacks .project-local/runs/wui-20261009/snapshot-readback.json and snapshot-readback2.json (20 top-level keys, 15 always present, 5 conditional), and the enum values are copied from apps/observer/frontend/src/types.ts:13-21 rather than invented.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "revision",
    "generatedAt",
    "sourceWatermark",
    "transport",
    "coverage",
    "governance",
    "workspace",
    "projects",
    "executions",
    "tasks",
    "tokenSummary",
    "git",
    "ci",
    "sourceRefs"
  ],
  "properties": {
    "schemaVersion": {
      "const": "workflow/snapshot/v3",
      "description": "Compared, never re-derived: api.ts parses the payload by comparing this literal, and the static contract refuses any file that EMBEDS a v3 snapshot literal."
    },
    "revision": {
      "type": "integer",
      "minimum": 0,
      "description": "Monotonic source of ordering. api.ts rejects a lower revision arriving after a higher one rather than letting a late older projection replace newer facts on screen."
    },
    "generatedAt": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$",
      "description": "RFC3339, the same rule snapshot_validator.py enforces with RFC3339_RE."
    },
    "sourceWatermark": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T",
      "description": "Nullable and required: the key is always present, and null is the statement that no source watermark was read. Absent-vs-null is not a distinction here; null-vs-a-timestamp is, so the field must never be dropped."
    },
    "transport": {
      "type": "object",
      "required": [
        "transportState",
        "freshnessState"
      ],
      "properties": {
        "transportState": {
          "enum": [
            "LIVE",
            "DELAYED",
            "OFFLINE",
            "CONNECTING",
            "UNKNOWN"
          ]
        },
        "freshnessState": {
          "enum": [
            "FRESH",
            "STALE",
            "UNKNOWN"
          ]
        },
        "eventsUrl": {
          "type": [
            "string",
            "null"
          ]
        },
        "connectedSince": {
          "type": [
            "string",
            "null"
          ]
        },
        "lastHeartbeatAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "writerWatermarkAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "eventStreamConnected": {
          "type": "boolean"
        }
      },
      "description": "Disconnect is not stop: OFFLINE never licenses a downstream 'stopped' claim (the read-only iron law)."
    },
    "coverage": {
      "type": "object",
      "required": [
        "numerator",
        "denominator",
        "scope"
      ],
      "properties": {
        "numerator": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "denominator": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "scope": {
          "type": [
            "string",
            "null"
          ],
          "description": "Nullable: build_snapshot emits coverage.scope = None when no coverage scope was computed. The first draft of this schema said `string` because the one live readback it was read off carried a string — validating the producer's minimal call instead of only its full one is what caught it. types.ts:36 already declared `string | null`, so the front model was right and the schema was wrong."
        }
      },
      "description": "A null denominator means unmeasurable, not zero, and the UI must not divide it into a percentage."
    },
    "governance": {
      "type": "object",
      "required": [
        "state",
        "families"
      ],
      "properties": {
        "state": {
          "enum": [
            "CLEAN",
            "DRIFT",
            "UNKNOWN"
          ]
        },
        "families": {
          "type": "object"
        }
      }
    },
    "workspace": {
      "type": "object",
      "description": "Plan/sources/history/governance projection. Interior keys are owned by the workflow side and validated semantically, not here."
    },
    "projects": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "projectId",
          "agentPlatform",
          "displayName",
          "identityState",
          "activityState",
          "attentionState",
          "activeExecutionCount",
          "workingAreas",
          "visibility",
          "quality",
          "lastStrongEvidenceAt",
          "repositories",
          "git",
          "token",
          "ci",
          "executionIds",
          "sourceRefs"
        ],
        "properties": {
          "projectId": {
            "type": "string",
            "minLength": 1
          },
          "agentPlatform": {
            "type": [
              "string",
              "null"
            ]
          },
          "displayName": {
            "type": [
              "string",
              "null"
            ]
          },
          "identityState": {
            "type": "string"
          },
          "activityState": {
            "enum": [
              "ACTIVE",
              "REGISTERED",
              "IDLE",
              "UNKNOWN"
            ]
          },
          "attentionState": {
            "type": "string"
          },
          "activeExecutionCount": {
            "type": "integer",
            "minimum": 0
          },
          "workingAreas": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "visibility": {
            "type": "string"
          },
          "quality": {
            "type": "string"
          },
          "lastStrongEvidenceAt": {
            "type": [
              "string",
              "null"
            ],
            "description": "Newest `observed_at` among this project's strong `source_quality` rows (the label `collectors.py` writes when it read a source exactly — `EXACT_SOURCE`), passed through verbatim by `composition_root._strong_evidence_map`. Null means this project owns no strong observation; it is not zero, not the snapshot's own `generatedAt`, and not 'never observed' — the Observer renders it as 无强证据时间 and the daily card's 最近变化 falls back to 待确认. Before 2026-10-27 the producer never emitted this key at all, so every card read 待确认 regardless of what the store held."
          },
          "repositories": {
            "type": "array"
          },
          "git": {
            "type": "object",
            "required": [
              "matchState"
            ],
            "properties": {
              "localSha": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "remoteSha": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "matchState": {
                "enum": [
                  "MATCH",
                  "LOCAL_REMOTE_MATCH",
                  "LOCAL_CI_MATCH",
                  "NO_LOCAL_CLAIM",
                  "UNVERIFIED",
                  "MISMATCH"
                ]
              },
              "branch": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "dirtyCount": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "observedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "quality": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "freshness": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sourceRef": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sourceProjectId": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "WL-L01 (2026-10-11): whose Git observation this block is showing. Equal to the row's own projectId for an own observation, null when the project has none — and never another project's id, because the old code fell back to whatever repository came first and printed its SHA/branch under this project's name. Null is the honest 'no Git row for this project'; it is not a licence to borrow."
              }
            },
            "additionalProperties": false
          },
          "token": {
            "type": "object",
            "required": [
              "costQuality"
            ],
            "properties": {
              "inputTokens": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "outputTokens": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "totalTokens": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "costQuality": {
                "enum": [
                  "EXACT",
                  "ESTIMATED",
                  "UNKNOWN"
                ]
              }
            },
            "additionalProperties": false
          },
          "ci": {
            "type": "array",
            "items": {
              "type": "object",
              "required": [
                "runId",
                "projectId",
                "workflow",
                "headSha",
                "status",
                "conclusion",
                "sourceRef"
              ],
              "properties": {
                "runId": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "projectId": {
                  "type": "string"
                },
                "workflow": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "headSha": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "status": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "conclusion": {
                  "type": [
                    "string",
                    "null"
                  ]
                },
                "sourceRef": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "additionalProperties": false
            },
            "description": "The project's rows selected from `ci_runs` by `projectId` (`snapshot_api.py:268`). Each item is a whole composition-root row, so it carries `projectId` — a row without one can never enter this list, because the filter compares it to the project id."
          },
          "executionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "description": "One row per product project. additionalProperties:false here is the point of this section: the top level has been closed since ERR-225 while this nested block kept seven of seventeen keys and accepted the other ten silently, so ten projected facts had no authority and a new one would still arrive un-named. Key set and types measured 2026-10-10 from snapshot_api.py::_project_projection (253-286) and pinned three ways by tests/workflow-assistance/test_snapshot_v3_schema_is_the_single_shape_authority.py against apps/observer/frontend/src/types.ts::Project. Note what the row does NOT carry: git.ciSha, so a row can state matchState=MATCH (computed from the upstream git dict) that cannot be re-derived from the row alone — the enum keeps all six values because reachability depends on the input, not on the emitted keys. token.* stays null for unknown and is never padded to 0."
      }
    },
    "executions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "executionId",
          "state"
        ],
        "properties": {
          "executionId": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "RUNNING",
              "STARTING",
              "WAITING_USER",
              "WAITING_APPROVAL",
              "BLOCKED",
              "COMPLETED",
              "FAILED",
              "UNKNOWN"
            ]
          },
          "anchorProjectId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "tasks": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
        "type": "integer"
      },
      "description": "Count map, not a record list: the task rows themselves are taskRecords, and the two carry different statements."
    },
    "tokenSummary": {
      "type": "object",
      "required": [
        "costQuality"
      ],
      "properties": {
        "inputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "outputTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "totalTokens": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0
        },
        "costQuality": {
          "enum": [
            "EXACT",
            "ESTIMATED",
            "UNKNOWN"
          ]
        }
      },
      "description": "Tokens stay separate from credits, subscription, cost and resource metrics; null is unknown and is never displayed as 0."
    },
    "git": {
      "type": "object",
      "required": [
        "matchState"
      ],
      "properties": {
        "localSha": {
          "type": [
            "string",
            "null"
          ]
        },
        "remoteSha": {
          "type": [
            "string",
            "null"
          ]
        },
        "ciSha": {
          "type": [
            "string",
            "null"
          ]
        },
        "matchState": {
          "enum": [
            "MATCH",
            "LOCAL_REMOTE_MATCH",
            "LOCAL_CI_MATCH",
            "NO_LOCAL_CLAIM",
            "UNVERIFIED",
            "MISMATCH"
          ],
          "description": "The six returns of snapshot_api.py::_git_match_state (366-380), in the order the function tests them. apps/observer/frontend/src/types.ts used to declare 'MATCH' | 'UNVERIFIED' | 'DRIFT' | 'UNKNOWN': three real outcomes were un-declarable and DRIFT/UNKNOWN could never arrive, so the shipped row (ProjectSummaryTable.tsx:119) prints the raw token while any code switching on DRIFT was dead. The pairing test pins this enum against the TypeScript union in both directions."
        },
        "branch": {
          "type": [
            "string",
            "null"
          ]
        },
        "dirtyCount": {
          "type": [
            "integer",
            "null"
          ]
        },
        "observedAt": {
          "type": [
            "string",
            "null"
          ]
        },
        "quality": {
          "type": [
            "string",
            "null"
          ]
        },
        "freshness": {
          "type": [
            "string",
            "null"
          ]
        },
        "sourceRef": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "ci": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "runId",
          "workflow",
          "headSha",
          "status",
          "conclusion",
          "sourceRef"
        ],
        "properties": {
          "runId": {
            "type": [
              "string",
              "null"
            ]
          },
          "workflow": {
            "type": [
              "string",
              "null"
            ]
          },
          "headSha": {
            "type": [
              "string",
              "null"
            ]
          },
          "status": {
            "type": [
              "string",
              "null"
            ]
          },
          "conclusion": {
            "type": [
              "string",
              "null"
            ]
          },
          "sourceRef": {
            "type": [
              "string",
              "null"
            ]
          }
        },
        "additionalProperties": false
      },
      "description": "The flat CI projection (`snapshot_api.py:97-107`): the six row facts without `projectId`, which is re-attached for the per-project view. Every key is emitted on every row even when the read missed, so the keys are required and their values nullable."
    },
    "sourceRefs": {
      "type": "array",
