          },
          "producer_gaps": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "description": "WUI-21: one `worklab/isolated-trial/v1` document per trial, embedded verbatim. There is no aggregate success field on purpose — each separated result carries its own status AND basis, so a trial cannot be summarised into one verdict it never earned."
      }
    },
    "collectors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "collector": {
            "type": "string",
            "minLength": 1
          },
          "totalRuns": {
            "type": "integer",
            "minimum": 0
          },
          "lastRunAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "lastSuccessAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "consecutiveFailures": {
            "type": "integer",
            "minimum": 0
          },
          "circuitOpen": {
            "type": "boolean"
          },
          "droppedEvents": {
            "type": "integer",
            "minimum": 0
          },
          "refusedRows": {
            "type": "integer",
            "minimum": 0
          },
          "deliveredRows": {
            "type": "integer",
            "minimum": 0
          },
          "lastRefusalReason": {
            "type": [
              "string",
              "null"
            ]
          },
          "fresh": {
            "type": "boolean"
          }
        },
        "required": [
          "collector",
          "totalRuns",
          "lastRunAt",
          "lastSuccessAt",
          "consecutiveFailures",
          "circuitOpen",
          "droppedEvents",
          "refusedRows",
          "deliveredRows",
          "lastRefusalReason",
          "fresh"
        ],
        "additionalProperties": false
      },
      "description": "Per-collector delivery and refusal counts, read from `collector_health` by `composition_root._collector_delivery_rows`. ABSENT means the health table could not be read at all; an empty list means every registered collector was read and none is registered — two different statements, which is why the section is optional rather than defaulted. `refusedRows` is the cumulative count of rows the source offered that were refused by named rule (ERR-256), and `lastRefusalReason` names the most frequent one plus the first place it happened; `droppedEvents` stays separate because it means events dropped from the collector's bounded queue, a different fault with a different remedy. `circuitOpen` is a boolean on purpose: the stored `circuit_open_until` is a `time.monotonic()` value from another process and means nothing to a reader. `fresh` is the SAME predicate `coverage.numerator` is counted with, so a collector cannot look healthy in one lane and stale in another."
    }
  },
  "allOf": [
    {
      "if": {
        "required": [
          "artifactHandles"
        ]
      },
      "then": {
        "required": [
          "artifactHandlesSummary"
        ]
      },
      "description": "A handle list with no stated scope reads as a complete list whether or not it is one."
    },
    {
      "if": {
        "required": [
          "artifactHandlesSummary"
        ]
      },
      "then": {
        "required": [
          "artifactHandles"
        ]
      },
      "description": "A scope report for a list this snapshot does not carry is a claim about a snapshot the reader is not looking at."
    }
  ]
}
