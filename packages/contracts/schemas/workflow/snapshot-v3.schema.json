  "allOf": [
    {
      "if": {
        "required": [
          "issues"
        ]
      },
      "then": {
        "required": [
          "issuesSummary"
        ]
      },
      "description": "An issue list with no stated scope is a claim that nothing was omitted, which the projection cannot make."
    },
    {
      "if": {
        "required": [
          "issuesSummary"
        ]
      },
      "then": {
        "required": [
          "issues"
        ]
      },
      "description": "A scope report for an issue list this snapshot does not carry is a claim about a snapshot the reader is not looking at."
    },
    {
      "if": {
        "required": [
          "artifactHandles"
        ]
      },
      "then": {
        "required": [
          "artifactHandlesSummary"
        ]
      },
      "description": "A handle list with no stated scope reads as a complete list whether or not it is one."
    },
    {
      "if": {
        "required": [
          "artifactHandlesSummary"
        ]
      },
      "then": {
        "required": [
          "artifactHandles"
        ]
      },
      "description": "A scope report for a list this snapshot does not carry is a claim about a snapshot the reader is not looking at."
    }
  ]
