            "items": {
              "type": "string"
            }
          },
          "visibility": {
            "type": "string"
          },
          "quality": {
            "type": "string"
          },
          "lastStrongEvidenceAt": {
            "type": [
              "string",
              "null"
            ]
          },
          "repositories": {
            "type": "array"
          },
          "git": {
            "type": "object",
            "required": [
              "matchState"
            ],
            "properties": {
              "localSha": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "remoteSha": {
