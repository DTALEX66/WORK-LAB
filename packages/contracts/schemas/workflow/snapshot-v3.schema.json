      "description": "Count map, not a record list: the task rows themselves are taskRecords, and the two carry different statements."
    },
    "tokenSummary": {
      "type": "object",
      "required": [
        "costQuality"
      ],
      "properties": {
        "inputTokens": {
          "type": [
            "integer",
            "null"
