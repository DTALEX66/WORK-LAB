                  "enum": [
                    "REGISTERED",
                    "INSTALLED",
                    "LOADED_CONNECTED",
                    "QUALIFIED",
                    "ENABLED_FOR_TASK",
                    "NATIVE_PROJECTION",
                    "OBSERVED_IN_EXECUTION"
                  ]
