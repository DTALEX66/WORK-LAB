                "type": [
                  "string",
                  "null"
                ]
              },
              "dirtyCount": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "observedAt": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "quality": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "freshness": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sourceRef": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "sourceProjectId": {
                "type": [
                  "string",
                  "null"
                ],
                "description": "WL-L01 (2026-10-11): whose Git observation this block is showing. Equal to the row's own projectId for an own observation, null when the project has none — and never another project's id, because the old code fell back to whatever repository came first and printed its SHA/branch under this project's name. Null is the honest 'no Git row for this project'; it is not a licence to borrow."
              }
            },
            "additionalProperties": false
          },
          "token": {
            "type": "object",
            "required": [
              "costQuality"
            ],
            "properties": {
              "inputTokens": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "outputTokens": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "totalTokens": {
                "type": [
                  "number",
                  "null"
                ],
                "minimum": 0
              },
              "costQuality": {
                "enum": [
                  "EXACT",
                  "ESTIMATED",
                  "UNKNOWN"
                ]
              }
            },
            "additionalProperties": false
          },
          "ci": {
            "type": "array",
            "items": {
              "type": "object"
            }
          },
          "executionIds": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "sourceRefs": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false,
        "description": "One row per product project. additionalProperties:false here is the point of this section: the top level has been closed since ERR-225 while this nested block kept seven of seventeen keys and accepted the other ten silently, so ten projected facts had no authority and a new one would still arrive un-named. Key set and types measured 2026-10-10 from snapshot_api.py::_project_projection (253-286) and pinned three ways by tests/workflow-assistance/test_snapshot_v3_schema_is_the_single_shape_authority.py against apps/observer/frontend/src/types.ts::Project. Note what the row does NOT carry: git.ciSha, so a row can state matchState=MATCH (computed from the upstream git dict) that cannot be re-derived from the row alone — the enum keeps all six values because reachability depends on the input, not on the emitted keys. token.* stays null for unknown and is never padded to 0."
      }
    },
    "executions": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "executionId",
          "state"
        ],
        "properties": {
          "executionId": {
            "type": "string",
            "minLength": 1
          },
          "state": {
            "enum": [
              "RUNNING",
              "STARTING",
              "WAITING_USER",
              "WAITING_APPROVAL",
              "BLOCKED",
              "COMPLETED",
              "FAILED",
              "UNKNOWN"
            ]
          },
          "anchorProjectId": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "tasks": {
      "type": "object",
      "propertyNames": {
        "type": "string"
      },
      "additionalProperties": {
