# Generated local runtime and evidence
.hermes/

# Python / Node / build caches
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
node_modules/
dist/
build/
# Vite/Vitest write their dep-optimizer + results cache at the invocation CWD;
# when the runner is started from the repo root that cache lands here.
.vite/
*.log

# Local secrets and credentials (never commit)
# Keep these rules exact: token/oauth/cookie/credential are also legitimate
# source, test, and governance vocabulary in this monorepo.
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/auth.json
**/credentials.json
**/cookies.json
**/cookie.sqlite
**/id_rsa*
**/id_ed25519*

# Local archive/staging must remain outside this root
WORK-LAB-ARCHIVE/
WORK-LAB-STAGING-*/
config/.backups/

**/.backups/
.project-local/
*.tsbuildinfo

# UI design-reference assets (extracted from the UI kit; design reference, not shipped source)
.ui-reference/

# Git LFS writes these four into core.hooksPath (.githooks) when `git lfs install` runs.
# They are per-clone tooling, not work product: .githooks/pre-commit stays tracked, and
# committing the LFS stubs would bake one machine's LFS state into every other clone.
.githooks/post-checkout
.githooks/post-commit
.githooks/post-merge
.githooks/pre-push
