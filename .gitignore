# Generated local runtime and evidence
80-evidence/
.hermes/

# Python / Node / build caches
__pycache__/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
node_modules/
dist/
build/
*.log

# Local secrets and credentials (never commit)
# Keep these rules exact: token/oauth/cookie/credential are also legitimate
# source, test, and governance vocabulary in this monorepo.
**/.env
**/.env.*
!**/.env.example
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/auth.json
**/credentials.json
**/cookies.json
**/cookie.sqlite
**/id_rsa*
**/id_ed25519*

# Local archive/staging must remain outside this root
WORK-LAB-ARCHIVE/
WORK-LAB-STAGING-*/
config/.backups/

**/.backups/
