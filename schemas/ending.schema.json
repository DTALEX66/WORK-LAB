{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "ending.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "priority", "conditions", "summary"],
  "properties": {
    "id": { "type": "string" },
    "name": { "type": "string" },
    "priority": { "type": "integer", "minimum": 0 },
    "conditions": { "type": "object" },
    "summary": { "type": "string" }
  }
}
