{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-lab/data-quality/v1",
  "title": "WORK-LAB Observer Data Quality",
  "type": "object",
  "required": ["quality", "coverage", "sourceCount", "acceptedCount", "rejectedCount"],
  "properties": {
    "quality": {"type": "string", "enum": ["source-exact", "deduplicated", "partial", "unknown"]},
    "coverage": {"type": "string", "enum": ["full", "partial", "unknown"]},
    "sourceCount": {"type": "integer", "minimum": 0},
    "acceptedCount": {"type": "integer", "minimum": 0},
    "rejectedCount": {"type": "integer", "minimum": 0},
    "reason": {"type": "string"}
  },
  "additionalProperties": false
}
