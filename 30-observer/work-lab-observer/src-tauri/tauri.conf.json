{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WORK-LAB Observer",
  "version": "0.1.0",
  "identifier": "com.dtalex.worklab.observer",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WORK-LAB Observer",
        "url": "index.html?view=full&mode=LIVE&theme=dark",
        "width": 1180,
        "height": 760,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "transparent": true,
        "decorations": false,
        "shadow": true
      },
      {
        "label": "panel",
        "title": "WORK-LAB Observer · 悬浮面板",
        "url": "index.html?view=compact&mode=LIVE&theme=dark",
        "width": 440,
        "height": 780,
        "minWidth": 440,
        "minHeight": 780,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "transparent": true,
        "decorations": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "WORK-LAB Observer",
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
