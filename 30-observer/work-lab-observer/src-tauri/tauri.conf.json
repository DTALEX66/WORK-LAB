{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WORK-LAB Observer",
  "version": "0.1.0",
  "identifier": "com.dtalex.worklab.observer",
  "build": {
    "frontendDist": "../web",
    "devUrl": "http://localhost:1420"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "WORK-LAB Observer",
        "url": "index.html?view=full&mode=UNKNOWN&theme=dark",
        "width": 1280,
        "height": 820,
        "minWidth": 320,
        "minHeight": 480,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "transparent": false,
        "decorations": false,
        "shadow": true,
        "backgroundColor": "#08090a"
      },
      {
        "label": "panel",
        "title": "WORK-LAB Observer · 悬浮面板",
        "url": "index.html?view=compact&mode=UNKNOWN&theme=dark",
        "width": 440,
        "height": 780,
        "minWidth": 440,
        "minHeight": 780,
        "resizable": false,
        "fullscreen": false,
        "visible": false,
        "transparent": false,
        "decorations": false,
        "shadow": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "backgroundColor": "#08090a"
      }
    ],
    "security": {
      "csp": "default-src 'self' http://127.0.0.1:* http://localhost:*; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' http://127.0.0.1:* http://localhost:*; font-src 'self'; frame-src 'none'; object-src 'none'; base-uri 'self'; form-action 'none'"
    },
    "trayIcon": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "tooltip": "WORK-LAB Observer",
      "menuOnLeftClick": false
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
