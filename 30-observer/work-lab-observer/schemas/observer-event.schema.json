{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-lab/observer-event/v1",
  "title": "WORK-LAB Observer Event",
  "type": "object",
  "required": ["eventId", "schemaVersion", "eventType", "sourceModule", "observedAt", "contentDigest", "quality"],
  "properties": {
    "eventId": {"type": "string", "minLength": 1},
    "schemaVersion": {"const": "work-lab/observer-event/v1"},
    "eventType": {"type": "string", "minLength": 1},
    "sourceModule": {"type": "string", "minLength": 1},
    "sourceId": {"type": "string", "minLength": 1},
    "projectId": {"type": "string", "minLength": 1},
    "taskId": {"type": "string", "minLength": 1},
    "runId": {"type": "string", "minLength": 1},
    "observedAt": {"type": "string", "minLength": 1},
    "occurredAt": {"type": "string", "minLength": 1},
    "originId": {"type": "string", "minLength": 1},
    "causationId": {"type": "string", "minLength": 1},
    "correlationId": {"type": "string", "minLength": 1},
    "contentDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "coverage": {"type": "string", "enum": ["full", "partial", "unknown"]},
    "quality": {"type": "string", "enum": ["source-exact", "deduplicated", "partial", "unknown"]},
    "usage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "total_tokens", "records"],
      "properties": {
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "records": {"type": "integer", "minimum": 0}
      }
    },
    "evidenceRefs": {"type": "array", "items": {"type": "string"}},
    "telemetry": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "operation": {"type": "string", "minLength": 1},
        "provider": {"type": "string", "minLength": 1},
        "model": {"type": "string", "minLength": 1},
        "input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "reasoning_tokens": {"type": "integer", "minimum": 0},
        "latency_ms": {"type": "number", "minimum": 0},
        "cache_read_tokens": {"type": "integer", "minimum": 0},
        "cache_write_tokens": {"type": "integer", "minimum": 0},
        "outcome": {"type": "string", "minLength": 1},
        "error_class": {"type": "string", "minLength": 1}
      }
    }
  },
  "additionalProperties": false
}
