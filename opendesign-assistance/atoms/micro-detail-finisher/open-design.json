{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "micro-detail-finisher",
  "title": "Micro-detail Finisher",
  "version": "0.2.1",
  "description": "Perform a bounded craft pass over typography, edges, masks, textures, alignment, transitions and repeated details.",
  "author": {
    "name": "DTALEX66 OPEN-DESIGN-Assistance"
  },
  "license": "MIT",
  "tags": [
    "atom",
    "visual-quality"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "atom",
    "mode": "atom",
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ]
    },
    "inputs": [
      {
        "name": "artifact",
        "type": "file",
        "required": true
      }
    ],
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ]
  }
}
