{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "cross-format-coherence-critic",
  "title": "Cross-format Coherence Critic",
  "version": "0.2.1",
  "description": "Verify that visual DNA survives across formats without becoming a color-swap template.",
  "author": {
    "name": "DTALEX66 OPEN-DESIGN-Assistance"
  },
  "license": "MIT",
  "tags": [
    "atom",
    "visual-quality"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "atom",
    "mode": "atom",
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ]
    },
    "inputs": [
      {
        "name": "artifacts",
        "type": "file",
        "required": true
      },
      {
        "name": "design_contract",
        "type": "file",
        "required": true
      }
    ],
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ]
  }
}
