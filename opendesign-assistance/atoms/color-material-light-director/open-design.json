{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "color-material-light-director",
  "title": "Color, Material & Light Director",
  "version": "0.2.1",
  "publishedAt": "2026-08-04T00:00:00Z",
  "description": "Build plausible color, material, surface, camera and lighting systems for 2D, 3D and spatial work.",
  "author": {
    "name": "DTALEX66 OPEN-DESIGN-Assistance"
  },
  "license": "MIT",
  "tags": [
    "atom",
    "visual-quality",
    "art-direction"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "atom",
    "taskKind": "new-generation",
    "mode": "atom",
    "useCase": {
      "query": {
        "en": "Build plausible color, material, surface, camera and lighting systems for 2D, 3D and spatial work.",
        "zh-CN": "Build plausible color, material, surface, camera and lighting systems for 2D, 3D and spatial work."
      }
    },
    "inputs": [
      {
        "name": "artifact",
        "type": "file",
        "required": true
      },
      {
        "name": "medium",
        "type": "string",
        "required": true
      },
      {
        "name": "production_profile",
        "type": "string",
        "required": false
      }
    ],
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ]
  }
}
