{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "visual-polish-loop",
  "title": "Visual Polish Loop",
  "version": "0.2.1",
  "publishedAt": "2026-08-04T00:00:00Z",
  "description": "Refine a visual artifact through bounded high-impact interventions and before/after comparison.",
  "author": {
    "name": "DTALEX66 OPEN-DESIGN-Assistance"
  },
  "license": "MIT",
  "tags": [
    "atom",
    "visual-quality",
    "art-direction"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "atom",
    "taskKind": "new-generation",
    "mode": "atom",
    "useCase": {
      "query": {
        "en": "Refine a visual artifact through bounded high-impact interventions and before/after comparison.",
        "zh-CN": "Refine a visual artifact through bounded high-impact interventions and before/after comparison."
      }
    },
    "inputs": [
      {
        "name": "artifact",
        "type": "file",
        "required": true
      },
      {
        "name": "target_score",
        "type": "number",
        "required": false
      },
      {
        "name": "max_iterations",
        "type": "number",
        "required": false
      }
    ],
    "capabilities": [
      "prompt:inject",
      "fs:write"
    ]
  }
}
