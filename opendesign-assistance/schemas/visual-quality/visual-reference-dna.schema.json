{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual Reference DNA",
  "type": "object",
  "required": [
    "reference_id",
    "macrostructure",
    "typography",
    "image_direction",
    "color_material",
    "forbidden_copy",
    "required_transformations"
  ],
  "properties": {
    "reference_id": {
      "type": "string"
    },
    "source": {
      "type": "string"
    },
    "rights_status": {
      "type": "string"
    },
    "macrostructure": {
      "type": "object"
    },
    "typography": {
      "type": "object"
    },
    "image_direction": {
      "type": "object"
    },
    "color_material": {
      "type": "object"
    },
    "motion_spatial": {
      "type": "object"
    },
    "observations": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "inferences": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "forbidden_copy": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_transformations": {
      "type": "array",
      "minItems": 3,
      "items": {
        "type": "string"
      }
    }
  },
  "additionalProperties": false
}
