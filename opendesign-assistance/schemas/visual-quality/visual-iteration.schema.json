{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Visual Iteration",
  "type": "object",
  "required": [
    "iteration",
    "before",
    "interventions",
    "after",
    "delta",
    "stop_reason"
  ],
  "properties": {
    "iteration": {
      "type": "integer",
      "minimum": 1
    },
    "before": {
      "type": "string"
    },
    "interventions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "string"
      }
    },
    "after": {
      "type": "string"
    },
    "delta": {
      "type": "number"
    },
    "regressions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "stop_reason": {
      "enum": [
        "score-met",
        "no-material-gain",
        "iteration-cap",
        "human-stop",
        "production-blocker"
      ]
    }
  },
  "additionalProperties": false
}
