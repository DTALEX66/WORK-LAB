{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Art Direction",
  "type": "object",
  "required": [
    "thesis",
    "audience_effect",
    "composition",
    "typography",
    "color",
    "image_world",
    "material_light",
    "production"
  ],
  "properties": {
    "thesis": {
      "type": "string"
    },
    "audience_effect": {
      "type": "string"
    },
    "composition": {
      "type": "object"
    },
    "typography": {
      "type": "object"
    },
    "color": {
      "type": "object"
    },
    "image_world": {
      "type": "object"
    },
    "material_light": {
      "type": "object"
    },
    "production": {
      "type": "object"
    },
    "references": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "source",
          "borrow",
          "do_not_copy"
        ],
        "properties": {
          "source": {
            "type": "string"
          },
          "borrow": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "do_not_copy": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        }
      }
    }
  },
  "additionalProperties": true
}
