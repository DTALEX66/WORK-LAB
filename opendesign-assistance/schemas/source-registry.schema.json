{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dtalex66.local/schemas/source-registry.schema.json",
  "title": "OPEN-DESIGN-Assistance Source Registry",
  "type": "object",
  "required": [
    "version",
    "generated_at",
    "entries"
  ],
  "properties": {
    "version": {
      "type": "string"
    },
    "generated_at": {
      "type": "string"
    },
    "policy": {
      "type": "string"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "id",
          "name",
          "category",
          "url",
          "license",
          "license_verified",
          "source_tier",
          "integration_mode",
          "status",
          "target",
          "absorb",
          "reviewed_at"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$"
          },
          "name": {
            "type": "string"
          },
          "category": {
            "type": "string"
          },
          "url": {
            "type": "string",
            "format": "uri"
          },
          "license": {
            "type": "string"
          },
          "license_verified": {
            "type": "boolean"
          },
          "source_tier": {
            "enum": [
              "A",
              "B",
              "C",
              "D"
            ]
          },
          "integration_mode": {
            "enum": [
              "vendor-adapt",
              "adapter",
              "derive",
              "reference",
              "quarantine"
            ]
          },
          "status": {
            "enum": [
              "adopt-now",
              "adapter-next",
              "reference-now",
              "review-required"
            ]
          },
          "target": {
            "type": "string"
          },
          "absorb": {
            "type": "string"
          },
          "restrictions": {
            "type": "string"
          },
          "reviewed_at": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": true
}
