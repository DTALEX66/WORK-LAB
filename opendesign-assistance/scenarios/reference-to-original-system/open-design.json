{
  "$schema": "https://open-design.ai/schemas/plugin.v1.json",
  "specVersion": "1.0.0",
  "name": "reference-to-original-system",
  "title": "Reference to Original System",
  "version": "0.2.1",
  "description": "Analyze references, extract anonymous DNA and synthesize an original multi-format design system.",
  "author": {
    "name": "DTALEX66 OPEN-DESIGN-Assistance"
  },
  "license": "MIT",
  "tags": [
    "scenario",
    "visual-quality",
    "art-direction"
  ],
  "compat": {
    "agentSkills": [
      {
        "path": "./SKILL.md"
      }
    ]
  },
  "od": {
    "kind": "scenario",
    "taskKind": "new-generation",
    "mode": "scenario",
    "scenario": "reference-to-original-system",
    "context": {
      "skills": [
        {
          "path": "./SKILL.md"
        }
      ],
      "atoms": [
        "visual-reference-dna-analyzer",
        "master-evidence-auditor",
        "style-vector-builder",
        "micro-detail-finisher",
        "photorealism-artifact-auditor",
        "cross-format-coherence-critic",
        "style-lineage-mapper",
        "art-direction-synthesizer",
        "typography-composition-director",
        "color-material-light-director",
        "visual-taste-jury",
        "anti-ai-slop-diagnostician"
      ],
      "assets": [
        "../../research/style-lineages/STYLE_ANALYSIS_CARDS.json",
        "../../research/master-studies/MASTER_REGISTRY.json",
        "../../research/master-studies/ANCHOR_METHOD_CARDS.json"
      ]
    },
    "pipeline": {
      "stages": [
        {
          "id": "rights-and-dna",
          "atoms": [
            "visual-reference-dna-analyzer"
          ],
          "onFailure": "abort"
        },
        {
          "id": "style-translation",
          "atoms": [
            "style-lineage-mapper",
            "style-vector-builder",
            "art-direction-synthesizer"
          ]
        },
        {
          "id": "directions",
          "atoms": [
            "direction-picker"
          ]
        },
        {
          "id": "craft",
          "atoms": [
            "typography-composition-director",
            "color-material-light-director",
            "media-image",
            "live-artifact"
          ]
        },
        {
          "id": "jury",
          "atoms": [
            "visual-taste-jury",
            "anti-ai-slop-diagnostician",
            "photorealism-artifact-auditor"
          ],
          "repeat": true,
          "until": "critique.score>=8.5 || iterations>=4"
        },
        {
          "id": "coherence",
          "atoms": [
            "cross-format-coherence-critic",
            "micro-detail-finisher",
            "delivery-packager"
          ]
        }
      ]
    },
    "inputs": [
      {
        "name": "brief",
        "type": "text",
        "required": true
      },
      {
        "name": "references",
        "type": "file",
        "required": true
      },
      {
        "name": "formats",
        "type": "text",
        "required": true
      }
    ],
    "capabilities": [
      "prompt:inject",
      "pipeline:*",
      "media:image",
      "fs:write"
    ]
  }
}
