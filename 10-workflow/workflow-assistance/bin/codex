#!/usr/bin/env bash
set -euo pipefail

# Codex CLI launcher for Workflow-assistance.
# 2026-08-20: switched from Windows Store OpenAI.Codex to official Git CLI
# (npm @openai/codex). Same ~/.codex CODEX_HOME: sessions, config, auth shared.
# Override with CODEX_CLI env var when needed.

if [[ -n "${CODEX_CLI:-}" && -x "$CODEX_CLI" ]]; then
  exec "$CODEX_CLI" "$@"
fi

NPM_ROOT="/c/Users/ALEX/AppData/Local/hermes/node"
if [[ -f "$NPM_ROOT/node_modules/@openai/codex/bin/codex.js" ]]; then
  exec "$NPM_ROOT/node.exe" "$NPM_ROOT/node_modules/@openai/codex/bin/codex.js" "$@"
fi

# fallback: legacy store runtime
STORE_EXE="$(powershell.exe -NoProfile -Command "(Get-AppxPackage -Name OpenAI.Codex)[0].InstallLocation + '\\app\\resources\\codex.exe'" 2>/dev/null || true)"
if [[ -n "$STORE_EXE" && -x "$STORE_EXE" ]]; then
  exec "$STORE_EXE" "$@"
fi
exit 127
