{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-assistance.invalid/schemas/agent-runtime-adapter.schema.json",
  "title": "Agent-runtime adapter contract (DSH)",
  "description": "Contract for an agent RUNTIME adapter (e.g. DeepSeek Harness). Distinct from config-layer client adapters: it executes tasks in an isolated worktree and has no config apply authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id", "kind", "upstream", "maturity", "install_mode",
    "entrypoints", "network", "workspace_scope", "secrets",
    "execution_authority", "external_mutation", "plugin_policy",
    "upgrade_policy", "rollback"
  ],
  "properties": {
    "schema_version": {"const": "workflow/agent-runtime-adapter/v1"},
    "adapter_id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,31}$"},
    "kind": {"const": "agent_runtime"},
    "upstream": {"type": "string", "minLength": 1},
    "upstream_version": {"type": "string", "minLength": 1},
    "license": {"type": "string", "minLength": 1},
    "maturity": {"const": "developer_preview"},
    "install_mode": {"const": "isolated_source_checkout"},
    "entrypoints": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"enum": ["web", "headless"]}
    },
    "network": {"const": "loopback_only"},
    "default_host": {"type": "string"},
    "default_port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "workspace_scope": {"const": "task_scoped_git_worktree_only"},
    "secrets": {"const": "runtime_secret_only"},
    "execution_authority": {"const": "execute_only_no_task_completion_authority"},
    "external_mutation": {"const": "approval_required"},
    "plugin_policy": {"const": "builtins_only"},
    "upgrade_policy": {"const": "pinned_commit + explicit_upgrade_task + compatibility_evidence"},
    "rollback": {"const": "stop_preserve_quarantine"}
  }
}
