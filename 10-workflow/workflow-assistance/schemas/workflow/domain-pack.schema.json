{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-assistance.invalid/schemas/workflow-domain-pack.schema.json",
  "title": "Client-Neutral Workflow Domain Pack",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "pack_id",
    "version",
    "display_name",
    "description",
    "capabilities",
    "entrypoints",
    "evidence_policy",
    "safety"
  ],
  "properties": {
    "schema_version": {
      "const": "workflow/domain-pack/v1"
    },
    "pack_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9._-]{2,63}$"
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "capabilities": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "entrypoints": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "human",
        "machine"
      ],
      "properties": {
        "human": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "machine": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "evidence_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "minimum_level",
        "required_artifacts"
      ],
      "properties": {
        "minimum_level": {
          "enum": [
            "E0",
            "E1",
            "E2",
            "E3",
            "E4",
            "E5"
          ]
        },
        "required_artifacts": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "safety": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "approval_required",
        "forbidden_paths",
        "redaction_required"
      ],
      "properties": {
        "approval_required": {
          "const": true
        },
        "forbidden_paths": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          }
        },
        "redaction_required": {
          "const": true
        }
      }
    }
  }
}
