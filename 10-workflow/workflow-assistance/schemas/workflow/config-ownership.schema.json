{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-assistance.invalid/schemas/config-ownership.schema.json",
  "title": "Platform-neutral configuration ownership contract v2",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "single_authority", "note", "layers", "operation_modes", "default_unknown", "adapter_defaults", "fields", "rules"],
  "properties": {
    "schema_version": {"const": "workflow/config-ownership/v2"},
    "single_authority": {"const": true},
    "note": {"type": "string", "minLength": 1},
    "layers": {
      "type": "object",
      "minProperties": 8,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["mode", "behavior"],
        "properties": {
          "mode": {"enum": ["MANAGE", "OBSERVE", "IGNORE", "FORBIDDEN"]},
          "behavior": {"type": "string", "minLength": 1}
        }
      }
    },
    "operation_modes": {"type": "array", "items": {"enum": ["MANAGE", "OBSERVE", "IGNORE", "FORBIDDEN"]}, "uniqueItems": true, "minItems": 4},
    "default_unknown": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mode", "quarantine"],
      "properties": {"mode": {"const": "OBSERVE"}, "quarantine": {"const": true}}
    },
    "adapter_defaults": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["layer", "mode", "preserve_unknown"],
        "properties": {
          "layer": {"type": "string", "minLength": 1},
          "mode": {"enum": ["MANAGE", "OBSERVE", "IGNORE", "FORBIDDEN"]},
          "preserve_unknown": {"const": true}
        }
      }
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "layer", "mode", "adapter"],
        "properties": {
          "path": {"type": "string", "minLength": 1},
          "layer": {"type": "string", "minLength": 1},
          "mode": {"enum": ["MANAGE", "OBSERVE", "IGNORE", "FORBIDDEN"]},
          "adapter": {"type": "string", "minLength": 1}
        }
      }
    },
    "rules": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "oneOf": [
          {"type": "boolean"},
          {"type": "string", "minLength": 1}
        ]
      }
    }
  }
}
