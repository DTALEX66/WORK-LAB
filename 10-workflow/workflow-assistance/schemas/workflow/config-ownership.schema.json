{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-assistance.invalid/schemas/config-ownership.schema.json",
  "title": "Platform-neutral configuration ownership contract",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "official_baseline", "user_overlay", "project_overlay", "excluded_layers", "fields"],
  "properties": {
    "schema_version": {"const": "workflow/config-ownership/v1"},
    "official_baseline": {"type": "object", "required": ["mode", "sources"], "properties": {"mode": {"const": "OBSERVE"}, "sources": {"type": "array", "minItems": 1, "items": {"type": "string"}}}, "additionalProperties": false},
    "user_overlay": {"type": "object", "required": ["mode", "preserve_unknown"], "properties": {"mode": {"const": "MANAGE"}, "preserve_unknown": {"const": true}}, "additionalProperties": false},
    "project_overlay": {"type": "object", "required": ["mode", "root"], "properties": {"mode": {"const": "MANAGE"}, "root": {"type": "string"}}, "additionalProperties": false},
    "excluded_layers": {"type": "array", "minItems": 1, "items": {"enum": ["PLATFORM_INTERNAL", "RUNTIME_EPHEMERAL", "SECRET"]}, "uniqueItems": true},
    "fields": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["path", "owner", "mode"], "properties": {"path": {"type": "string", "minLength": 1}, "owner": {"enum": ["UPSTREAM_OFFICIAL", "USER_OVERLAY", "PROJECT_OVERLAY", "PLATFORM_INTERNAL", "RUNTIME_EPHEMERAL", "SECRET"]}, "mode": {"enum": ["MANAGE", "OBSERVE", "IGNORE", "FORBIDDEN"]}, "adapter": {"type": "string"}}}}
  }
}
