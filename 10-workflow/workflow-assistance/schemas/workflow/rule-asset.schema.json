{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-lab/rule-asset/v1",
  "title": "WORK-LAB Rule Asset",
  "type": "object",
  "required": ["schema_version", "id", "version", "origin", "scope", "risk", "status"],
  "properties": {
    "schema_version": {"const": "workflow/rule-asset/v1"},
    "id": {"type": "string", "minLength": 1},
    "version": {"type": "string", "minLength": 1},
    "origin": {"type": "string", "minLength": 1},
    "scope": {"type": "string", "enum": ["session", "project", "domain", "client", "global"]},
    "risk": {"type": "string", "enum": ["low", "medium", "high", "critical"]},
    "status": {"type": "string", "enum": ["candidate", "isolated", "approved", "deployed", "blocked", "retired"]},
    "packageDigest": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
  },
  "additionalProperties": false
}
