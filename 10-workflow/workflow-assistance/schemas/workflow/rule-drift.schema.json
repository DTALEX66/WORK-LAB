{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-lab/rule-drift/v1",
  "title": "WORK-LAB Rule Drift Projection",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "drift_id", "rule_id", "baseline_digest", "observed_digest", "state", "severity", "action"],
  "properties": {
    "schema_version": {"const": "workflow/rule-drift/v1"},
    "drift_id": {"type": "string", "minLength": 1},
    "rule_id": {"type": "string", "minLength": 1},
    "baseline_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "observed_digest": {"type": ["string", "null"], "pattern": "^[a-f0-9]{64}$"},
    "state": {"enum": ["unchanged", "changed", "missing", "new"]},
    "severity": {"enum": ["info", "medium", "high"]},
    "action": {"enum": ["report-only", "quarantine", "manual-review"]}
  }
}
