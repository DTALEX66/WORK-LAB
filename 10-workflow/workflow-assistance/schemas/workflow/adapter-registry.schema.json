{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://workflow-assistance.invalid/schemas/adapter-registry.schema.json",
  "title": "Workflow Adapter Provenance Registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "interface", "entries"],
  "properties": {
    "schema_version": {"const": "workflow/adapter-registry/v1"},
    "interface": {
      "type": "array",
      "const": ["detect", "capabilities", "plan", "apply", "invoke", "observe", "rollback"]
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "display_name", "support_level", "operations", "detection", "provenance"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{2,31}$"},
          "display_name": {"type": "string", "minLength": 1},
          "support_level": {"enum": ["deep", "manifest-only", "experimental", "blocked"]},
          "operations": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"enum": ["detect", "capabilities", "plan", "apply", "invoke", "observe", "rollback"]}
          },
          "detection": {
            "type": "object",
            "additionalProperties": false,
            "required": ["mode", "evidence_state"],
            "properties": {
              "mode": {"enum": ["static", "isolated", "runtime", "external"]},
              "evidence_state": {"enum": ["NOT_RUN", "PASS", "FAIL", "BLOCKED", "UNVERIFIED", "SKIPPED_OPTIONAL"]}
            }
          },
          "provenance": {
            "type": "object",
            "additionalProperties": false,
            "required": ["source_kind", "source_ref", "version", "scope", "risk", "status", "hash"],
            "properties": {
              "source_kind": {"enum": ["repository", "external-manifest", "official-cli", "user-selected"]},
              "source_ref": {"type": "string", "minLength": 1},
              "version": {"type": "string", "minLength": 1},
              "version_historical": {"type": "array", "items": {"type": "string"}},
              "scope": {"type": "string", "minLength": 1},
              "risk": {"enum": ["low", "medium", "high", "critical"]},
              "status": {"enum": ["active", "quarantined", "blocked", "retired"]},
              "hash": {
                "type": "object",
                "additionalProperties": false,
                "required": ["algorithm", "value", "state", "basis", "files"],
                "properties": {
                  "algorithm": {"const": "sha256"},
                  "value": {"type": ["string", "null"], "pattern": "^[0-9a-f]{64}$"},
                  "state": {"enum": ["AVAILABLE", "UNAVAILABLE"]},
                  "basis": {"type": "string", "minLength": 1},
                  "files": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
                }
              }
            }
          }
        }
      }
    }
  }
}
