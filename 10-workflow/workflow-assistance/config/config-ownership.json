{
  "schema_version": "workflow/config-ownership/v2",
  "single_authority": true,
  "note": "WL3-200: single source replacing config-ownership v1, managed-config-schema.yaml field lists, and hard-coded sync-script managed config. Unknown fields default to OBSERVE/QUARANTINE; never silently deleted. Managed surface as of 2026-08-11: active clients hermes/codex/cc-switch/github (deep), observe-only platforms openhuman/open-design (skills + OBSERVE declarations), manifest-only future clients cursor/claude-code/workbuddy, and the workflow adapter itself.",
  "layers": {
    "UPSTREAM_OFFICIAL": {"mode": "OBSERVE", "behavior": "read-only version/capability/schema/digest; never copy install tree"},
    "USER_OVERLAY": {"mode": "MANAGE", "behavior": "user Rules, 13 Skills, plugin declarations, boundaries, explicit preferences; diff/rebase/rollback"},
    "PROJECT_OVERLAY": {"mode": "MANAGE", "behavior": "project Rules/Skills/Profile/Gate; acts on current project only"},
    "TASK_EPHEMERAL": {"mode": "OBSERVE", "behavior": "current task context; expires at task end; never auto-promotes to global"},
    "PLATFORM_INTERNAL": {"mode": "OBSERVE", "behavior": "observe necessary metadata only; never manage"},
    "RUNTIME_EPHEMERAL": {"mode": "IGNORE", "behavior": "ignored runtime state; never committed"},
    "SECRET": {"mode": "FORBIDDEN", "behavior": "never collected, copied, hashed, or archived"},
    "COSMETIC": {"mode": "IGNORE", "behavior": "default user-owned/ignore; optional manage only when user opts in and official interface is stable"}
  },
  "operation_modes": ["MANAGE", "OBSERVE", "IGNORE", "FORBIDDEN"],
  "default_unknown": {"mode": "OBSERVE", "quarantine": true},
  "adapter_defaults": {
    "hermes": {"layer": "USER_OVERLAY", "mode": "MANAGE", "preserve_unknown": true},
    "codex": {"layer": "USER_OVERLAY", "mode": "MANAGE", "preserve_unknown": true},
    "cc-switch": {"layer": "USER_OVERLAY", "mode": "OBSERVE", "preserve_unknown": true},
    "github": {"layer": "USER_OVERLAY", "mode": "OBSERVE", "preserve_unknown": true},
    "openhuman": {"layer": "PLATFORM_INTERNAL", "mode": "OBSERVE", "preserve_unknown": true},
    "open-design": {"layer": "PROJECT_OVERLAY", "mode": "OBSERVE", "preserve_unknown": true},
    "workflow": {"layer": "USER_OVERLAY", "mode": "MANAGE", "preserve_unknown": true},
    "cursor": {"layer": "USER_OVERLAY", "mode": "OBSERVE", "preserve_unknown": true},
    "claude-code": {"layer": "USER_OVERLAY", "mode": "OBSERVE", "preserve_unknown": true},
    "workbuddy": {"layer": "USER_OVERLAY", "mode": "OBSERVE", "preserve_unknown": true}
  },
  "fields": [
    {"path": "display.language", "layer": "USER_OVERLAY", "mode": "MANAGE", "adapter": "hermes"},
    {"path": "display.busy_input_mode", "layer": "USER_OVERLAY", "mode": "MANAGE", "adapter": "hermes"},
    {"path": "display.theme", "layer": "COSMETIC", "mode": "IGNORE", "adapter": "hermes"},
    {"path": "project.AGENTS", "layer": "PROJECT_OVERLAY", "mode": "MANAGE", "adapter": "codex"},
    {"path": "project.rules", "layer": "PROJECT_OVERLAY", "mode": "MANAGE", "adapter": "codex"},
    {"path": "project.skills", "layer": "PROJECT_OVERLAY", "mode": "MANAGE", "adapter": "codex"},
    {"path": "user.AGENTS", "layer": "USER_OVERLAY", "mode": "MANAGE", "adapter": "codex"},
    {"path": "user.skills", "layer": "USER_OVERLAY", "mode": "MANAGE", "adapter": "codex"},
    {"path": "codex.model.routing", "layer": "USER_OVERLAY", "mode": "OBSERVE", "adapter": "codex"},
    {"path": "codex.model.provider", "layer": "USER_OVERLAY", "mode": "OBSERVE", "adapter": "codex"},
    {"path": "codex.model.base_url", "layer": "USER_OVERLAY", "mode": "OBSERVE", "adapter": "codex"},
    {"path": "approval_policy", "layer": "USER_OVERLAY", "mode": "MANAGE", "adapter": "codex"},
    {"path": "sandbox_mode", "layer": "USER_OVERLAY", "mode": "MANAGE", "adapter": "codex"},
    {"path": "project_doc_max_bytes", "layer": "USER_OVERLAY", "mode": "MANAGE", "adapter": "codex"},
    {"path": "mcp_servers.user_defined", "layer": "USER_OVERLAY", "mode": "OBSERVE", "adapter": "hermes"},
    {"path": "mcp_servers.owned_names", "layer": "USER_OVERLAY", "mode": "OBSERVE", "adapter": "hermes"},
    {"path": "plugins", "layer": "USER_OVERLAY", "mode": "OBSERVE", "adapter": "hermes"},
    {"path": "hooks.pre_tool_call", "layer": "USER_OVERLAY", "mode": "OBSERVE", "adapter": "hermes"},
    {"path": "memory", "layer": "USER_OVERLAY", "mode": "OBSERVE", "adapter": "hermes"},
    {"path": "sessions.auto_prune", "layer": "USER_OVERLAY", "mode": "OBSERVE", "adapter": "hermes"},
    {"path": "hermes.model.provider", "layer": "USER_OVERLAY", "mode": "MANAGE", "adapter": "hermes"},
    {"path": "hermes.model.default", "layer": "USER_OVERLAY", "mode": "MANAGE", "adapter": "hermes"},
    {"path": "hermes.model.base_url", "layer": "USER_OVERLAY", "mode": "MANAGE", "adapter": "hermes"},
    {"path": "cc_switch.provider.catalog", "layer": "USER_OVERLAY", "mode": "MANAGE", "adapter": "cc-switch"},
    {"path": "cc_switch.provider.routing", "layer": "USER_OVERLAY", "mode": "MANAGE", "adapter": "cc-switch"},
    {"path": "codex.prompt_sync", "layer": "PLATFORM_INTERNAL", "mode": "IGNORE", "adapter": "cc-switch"},
    {"path": "codex.skill_sync", "layer": "PLATFORM_INTERNAL", "mode": "IGNORE", "adapter": "cc-switch"},
    {"path": "codex.session_sync", "layer": "RUNTIME_EPHEMERAL", "mode": "IGNORE", "adapter": "cc-switch"},
    {"path": "hermes.memory_sync", "layer": "RUNTIME_EPHEMERAL", "mode": "IGNORE", "adapter": "cc-switch"},
    {"path": "chatgpt.memory", "layer": "PLATFORM_INTERNAL", "mode": "OBSERVE", "adapter": "codex"},
    {"path": "codex.local_memories", "layer": "RUNTIME_EPHEMERAL", "mode": "IGNORE", "adapter": "codex"},
    {"path": "memory.growth_policy", "layer": "USER_OVERLAY", "mode": "MANAGE", "adapter": "workflow"},
    {"path": "openhuman.workspace_metadata", "layer": "PLATFORM_INTERNAL", "mode": "OBSERVE", "adapter": "openhuman"},
    {"path": "openhuman.global_configuration", "layer": "USER_OVERLAY", "mode": "MANAGE", "adapter": "openhuman"},
    {"path": "openhuman.runtime_memory", "layer": "RUNTIME_EPHEMERAL", "mode": "IGNORE", "adapter": "openhuman"},
    {"path": "open-design.read_only_mcp", "layer": "PROJECT_OVERLAY", "mode": "OBSERVE", "adapter": "open-design"},
    {"path": "open-design.global_configuration", "layer": "USER_OVERLAY", "mode": "MANAGE", "adapter": "open-design"},
    {"path": "desktop.internal_state", "layer": "PLATFORM_INTERNAL", "mode": "OBSERVE", "adapter": "codex"},
    {"path": "desktop.global_state_digest", "layer": "PLATFORM_INTERNAL", "mode": "OBSERVE", "adapter": "codex"},
    {"path": "task.lease", "layer": "TASK_EPHEMERAL", "mode": "OBSERVE", "adapter": "workflow"},
    {"path": "task.checkpoint", "layer": "TASK_EPHEMERAL", "mode": "OBSERVE", "adapter": "workflow"},
    {"path": "sessions", "layer": "RUNTIME_EPHEMERAL", "mode": "IGNORE", "adapter": "hermes"},
    {"path": "cache", "layer": "RUNTIME_EPHEMERAL", "mode": "IGNORE", "adapter": "workflow"},
    {"path": "logs", "layer": "RUNTIME_EPHEMERAL", "mode": "IGNORE", "adapter": "workflow"},
    {"path": "credentials", "layer": "SECRET", "mode": "FORBIDDEN", "adapter": "all"},
    {"path": "api_keys", "layer": "SECRET", "mode": "FORBIDDEN", "adapter": "all"},
    {"path": "auth_tokens", "layer": "SECRET", "mode": "FORBIDDEN", "adapter": "all"},
    {"path": "oauth_state", "layer": "SECRET", "mode": "FORBIDDEN", "adapter": "all"},
    {"path": "prompt_response_bodies", "layer": "SECRET", "mode": "FORBIDDEN", "adapter": "all"}
  ],
  "rules": {
    "unknown_field_default": "OBSERVE_QUARANTINE",
    "secret_never_collected": true,
    "user_overlay_cannot_weaken_official_security": true,
    "official_deprecated_fields_preserve_user_intent": true,
    "identity_must_be_unique_before_apply": true,
    "apply_requires_stable_official_interface": true,
    "cosmetic_managed_only_on_opt_in": true,
    "cc_switch_owns_supported_client_provider_routing_only": true,
    "cross_client_prompt_skill_session_sync_forbidden": true,
    "raw_memory_never_crosses_client_boundary": true
  }
}
