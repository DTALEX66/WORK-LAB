    {"path": "project.rules", "owner": "PROJECT_OVERLAY", "mode": "MANAGE", "adapter": "codex"},
    {"path": "model.routing", "owner": "USER_OVERLAY", "mode": "OBSERVE", "adapter": "codex"},
