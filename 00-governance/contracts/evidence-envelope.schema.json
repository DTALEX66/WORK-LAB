{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "work-lab/evidence-envelope/v1",
  "type": "object",
  "required": ["schemaVersion", "taskId", "runId", "status", "source"],
  "properties": {
    "schemaVersion": {"const": "work-lab/evidence-envelope/v1"},
    "taskId": {"type": "string"},
    "runId": {"type": "string"},
    "status": {"enum": ["PASS", "FAIL", "BLOCKED", "UNKNOWN"]},
    "source": {"type": "string"},
    "contentBodies": {"const": "excluded"},
    "credentials": {"const": "excluded"}
  },
  "additionalProperties": true
}
