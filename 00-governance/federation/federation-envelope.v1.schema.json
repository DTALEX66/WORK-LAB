{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://workflow-assistance.invalid/schemas/federation-envelope.v1.schema.json",
  "title": "Federation Envelope V1",
  "description": "Common envelope fields for all cross-project messages (TP-20260819 section 6.2).",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "messageId", "producer", "consumer", "correlationId", "contentHash", "classification", "rightsStatus", "createdAt", "idempotencyKey"],
  "properties": {
    "schemaVersion": {"type": "string"},
    "messageId": {"type": "string", "minLength": 1},
    "producer": {"enum": ["archeaxis-knowledge-os", "work-lab", "design-lab"]},
    "consumer": {"enum": ["archeaxis-knowledge-os", "work-lab", "design-lab"]},
    "correlationId": {"type": "string"},
    "workUnitId": {"type": "string"},
    "sourceCommit": {"type": "string"},
    "contentHash": {"type": "string"},
    "classification": {"type": "string"},
    "rightsStatus": {"type": "string"},
    "createdAt": {"type": "string", "format": "date-time"},
    "idempotencyKey": {"type": "string", "minLength": 1}
  }
}
