{
  "schemaVersion": "work-lab-monorepo/v1",
  "workspaceId": "work-lab",
  "repository": "DTALEX66/WORK-LAB",
  "rootResolution": ["explicit-argument", "manifest-relative-path", "environment-variable", "current-git-root"],
  "modules": [
    {
      "id": "workflow-assistance",
      "path": "10-workflow/workflow-assistance",
      "legacyRepository": "DTALEX66/Workflow-assistance",
      "role": "client-neutral workflow governance, execution control and observability",
      "releasePrefix": "workflow",
      "owner": "DTALEX66",
      "dependsOn": []
    },

    {
      "id": "work-lab-observer",
      "path": "30-observer/work-lab-observer",
      "legacyRepository": null,
      "role": "strictly read-only derived observation and evidence projections",
      "releasePrefix": "observer",
      "owner": "DTALEX66",
      "dependsOn": ["workflow-assistance"]
    }
  ],
  "singleWriter": true,
  "forbiddenRoots": ["E:\\"],
  "generatedData": {
    "runtimeRoot": ".hermes/task-runtime",
    "taskArtifactsPath": ".hermes/task-artifacts",
    "evidencePath": "80-evidence",
    "tracked": false
  },
  "externalMutationDefault": false
}
