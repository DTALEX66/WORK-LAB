schema_version = 9
default_model = "chat-v1"
default_temperature = 0.7
temperature_unsupported_models = [
    "o1*",
    "o3*",
    "o4*",
    "gpt-5*",
    "kimi-k2*",
    "moonshot*",
    "moonshotai/*",
]
agent_activity_level = 2
model_routes = []
embedding_routes = []
capability_providers = []
memory_sources = []
voice_providers = []
onboarding_completed = true
chat_onboarding_completed = false
composio_source_caps_migration_version = 1

[dashboard.event_stream]
enabled = true
max_entries = 200
new_entries = "top"

[dashboard.model_health]
enabled = true
hallucination_threshold = 0.1
min_tasks_for_rating = 10
evaluation_window_tasks = 50

[dashboard.diagram_viewer]
enabled = true
source_url = "http://localhost:8787/workspace/diagrams/latest.png"
refresh_interval_seconds = 10

[observability]
analytics_enabled = true
share_usage_data = true

[observability.agent_tracing]
enabled = false
backend = "otel"
capture_content = true

[autonomy]
level = "supervised"
workspace_only = true
allowed_commands = [
    "git",
    "npm",
    "pnpm",
    "yarn",
    "cargo",
    "make",
    "cmake",
    "ls",
    "cat",
    "grep",
    "find",
    "echo",
    "pwd",
    "wc",
    "head",
    "tail",
    "date",
    "sort",
    "uniq",
    "diff",
    "which",
    "uname",
    "basename",
    "dirname",
    "tr",
    "cut",
    "realpath",
    "readlink",
    "stat",
    "file",
    "mkdir",
    "touch",
    "cp",
    "mv",
    "ln",
    "dir",
    "type",
    "where",
    "findstr",
    "more",
]
forbidden_paths = [
    "/etc",
    "/root",
    "/home",
    "/usr",
    "/bin",
    "/sbin",
    "/lib",
    "/opt",
    "/boot",
    "/dev",
    "/proc",
    "/sys",
    "/var",
    "/tmp",
    "~/.ssh",
    "~/.gnupg",
    "~/.aws",
    "~/.config",
]
max_actions_per_hour = 4294967295
max_cost_per_day_cents = 500
require_approval_for_medium_risk = true
block_high_risk_commands = true
auto_approve = [
    "file_read",
    "memory_search",
    "memory_list",
    "get_time",
    "list_dir",
    "glob",
    "grep",
    "shell",
]
auto_approve_all = false
trusted_roots = []
allow_tool_install = false
require_task_plan_approval = true

[privacy]
mode = "standard"

[sandbox]
backend = "auto"
firejail_args = []

[runtime]
kind = "native"

[runtime.docker]
image = "alpine:3.20"
network = "none"
memory_limit_mb = 512
cpu_limit = 1.0
read_only_rootfs = true
mount_workspace = true
allowed_workspace_roots = []

[shell]
hide_window = false

[reliability]
provider_retries = 2
provider_backoff_ms = 500
fallback_providers = []
channel_initial_backoff_secs = 2
channel_max_backoff_secs = 60
scheduler_poll_secs = 15
scheduler_retries = 2

[reliability.model_fallbacks]

[scheduler]
enabled = true
max_tasks = 64
max_concurrent = 4

[scheduler_gate]
mode = "auto"
battery_floor = 0.8
cpu_busy_threshold_pct = 70.0
throttled_backoff_ms = 30000
paused_poll_ms = 60000
cpu_severe_pct = 95.0
require_ac_power = false

[orchestration]
enabled = true

[orchestration.medulla.prompt_overrides]

[orchestration.medulla.config]

[orchestration.medulla.limits]

[agent]
compact_context = false
max_tool_iterations = 10
max_history_messages = 50
parallel_tools = false
max_parallel_tools = 4
tool_dispatcher = "auto"
max_memory_context_chars = 2000
tool_result_budget_bytes = 16384
agent_timeout_secs = 120
session_dual_write = true
session_shadow_reads = true
agents_md_enabled = true

[agent.channel_permissions]

[orchestrator]

[teams]

[context]
enabled = true
microcompact_enabled = true
autocompact_enabled = true
microcompact_keep_recent = 5
tool_result_budget_bytes = 16384
summarizer_payload_threshold_tokens = 4000
summarizer_max_payload_tokens = 2000000
prefer_markdown_tool_output = true
compaction_enabled = true
super_context_enabled = false

[context.session_memory]
min_token_growth = 4000
min_tool_calls = 8
min_turns_between = 4

[heartbeat]
enabled = false
interval_minutes = 5
inference_enabled = false
context_budget_tokens = 40000
notify_meetings = false
notify_reminders = false
notify_relevant_events = false
external_delivery_enabled = false
meeting_lookahead_minutes = 120
max_calendar_connections_per_tick = 2
reminder_lookahead_minutes = 30
subconscious_mode = "off"
triggers_enabled = false
max_promotions_per_hour = 30
goal_continuation_enabled = false
goal_idle_minutes = 10

[subconscious]
engine = "local"

[subconscious.medulla_local]
serve_entry = ""
request_deadline_secs = 300

[cron]
enabled = true
max_run_history = 50

[task_sources]
enabled = true
default_interval_secs = 1800
max_tasks_per_fetch = 25
auto_proactive = true

[channels_config]
cli = true
message_timeout_secs = 300

[memory]
backend = "sqlite"
auto_save = true
embedding_provider = "cloud"
embedding_model = "embedding-v1"
embedding_dimensions = 1024
embedding_rate_limit_per_min = 60
min_relevance_score = 0.4

[memory_tree]
embedding_timeout_ms = 10000
embedding_strict = false
llm_extractor_endpoint = "http://localhost:11434"
llm_extractor_model = "gemma3:4b"
llm_extractor_timeout_ms = 15000
llm_summariser_endpoint = "http://localhost:11434"
llm_summariser_model = "gemma3:4b"
llm_summariser_timeout_ms = 120000
llm_backend = "cloud"
cloud_llm_model = "summarization-v1"
cloud_summarization_opt_in = false
spacy_enabled = true

[storage.provider.config]
provider = ""

[composio]
enabled = false
entity_id = "default"
triage_disabled = false
triage_disabled_toolkits = []
mode = "backend"

[secrets]
encrypt = true

[browser]
enabled = false
allowed_domains = []
backend = "auto"
native_headless = true
native_webdriver_url = "http://127.0.0.1:9515"

[browser.computer_use]
endpoint = "http://127.0.0.1:8787/v1/actions"
timeout_ms = 15000
allow_remote_endpoint = false
window_allowlist = []

[http_request]
allowed_domains = ["*"]
max_response_size = 1000000
timeout_secs = 30

[curl]
dest_subdir = "downloads"
max_download_bytes = 52428800
timeout_secs = 120

[gitbooks]
enabled = true
