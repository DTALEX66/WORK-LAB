prefix_rule(pattern=["C:\\Users\\ALEX\\AppData\\Local\\Microsoft\\PowerShell\\7\\pwsh.exe", "-Command", "$shortcutPath = 'C:\\Users\\ALEX\\Desktop\\Hermes.lnk'; $targetPath = 'C:\\Users\\ALEX\\AppData\\Local\\hermes\\hermes-agent\\apps\\desktop\\release\\win-unpacked\\Hermes.exe'; $workingDirectory = [System.IO.Path]::GetDirectoryName($targetPath); $iconPath = [System.IO.Path]::Combine($workingDirectory, 'resources\\icon.ico'); if (-not (Test-Path -LiteralPath $targetPath)) { throw \"Target not found: $targetPath\" }; $shell = New-Object -ComObject WScript.Shell; $shortcut = $shell.CreateShortcut($shortcutPath); $shortcut.TargetPath = $targetPath; $shortcut.WorkingDirectory = $workingDirectory; if (Test-Path -LiteralPath $iconPath) { $shortcut.IconLocation = \"$iconPath,0\" }; $shortcut.Save(); $verify = $shell.CreateShortcut($shortcutPath); $valid = (Test-Path -LiteralPath $verify.TargetPath) -and (Test-Path -LiteralPath $verify.WorkingDirectory); [PSCustomObject]@{Valid=$valid; Shortcut=$shortcutPath; TargetPath=$verify.TargetPath; TargetExists=Test-Path -LiteralPath $verify.TargetPath; WorkingDirectory=$verify.WorkingDirectory; WorkingDirectoryExists=Test-Path -LiteralPath $verify.WorkingDirectory; IconLocation=$verify.IconLocation; IconExists=Test-Path -LiteralPath ($verify.IconLocation -replace ',0$','')} | ConvertTo-Json; if (-not $valid) { exit 1 }"], decision="allow")
