{
  "name": "Abnormal Elevator Console UI Kit",
  "viewport": {
    "baseWidth": 375,
    "baseHeight": 812,
    "safeTouchHeight": 52
  },
  "colors": {
    "bg": "#090d0d",
    "panel": "#111817",
    "metal": "#202725",
    "text": "#c2ccc5",
    "muted": "#6f8078",
    "signalGreen": "#7ed6b0",
    "signalCyan": "#7accc7",
    "warningRed": "#ca5b54",
    "amber": "#c2a45f"
  },
  "buttons": {
    "variants": [
      "neutral",
      "recommended",
      "danger",
      "secondary"
    ],
    "states": [
      "default",
      "pressed",
      "disabled",
      "cooldown",
      "confirmRequired",
      "confirming",
      "locked"
    ],
    "rules": [
      "Neutral uses cold grey metal surface with dim green LED.",
      "Recommended uses thin green/cyan outline only, no large neon glow.",
      "Danger uses desaturated red and requires long press or slide confirm.",
      "Secondary buttons are wider and lower priority."
    ]
  },
  "components": [
    "CctvHeader",
    "CctvViewer",
    "AnomalyAlert",
    "Countdown",
    "StabilityMeter",
    "PowerMeter",
    "ThreatMeter",
    "MainActionDeck",
    "SecondaryActionDeck",
    "MoreDrawer",
    "LogPanel",
    "DangerConfirmPanel",
    "CommandHint"
  ]
}